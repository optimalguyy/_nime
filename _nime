sub_tracks=""
sub_code=""
sub_label=""
list_subs=0
index=""
ep_no=""
query=""
source="search"
player_function=""
replay=""
skip_flag=""
stream_flags=""
do_check_deps=0

while [ $# -gt 0 ]; do
	case "$1" in
		-s | --source)
			die "-s is gone: both sources are searched at once now, just give the title"
			;;
		-c | --continue) source=history ;;
		-d | --download) player_function=download ;;
		-D | --delete)
			: >"$histfile"
			info "History deleted"
			exit 0
			;;
		-q | --quality)
			[ $# -lt 2 ] && die "missing argument!"
			quality=$2
			shift
			;;
		-e | --episode | -r | --range)
			[ $# -lt 2 ] && die "missing argument!"
			ep_no=$2
			shift
			;;
		-S | --select-nth)
			[ $# -lt 2 ] && die "missing argument!"
			index=$2
			shift
			;;
		-v | --vlc) player_function=vlc ;;
		--dub) mode=dub ;;
		-sub | --sub) mode=sub ;;
		-engdub | --engdub | -gerdub | --gerdub | -fredub | --fredub | -spadub | --spadub | \
			-itudub | -itadub | --itadub | -pordub | --pordub | -rusdub | --rusdub | -aradub | --aradub)
			# one flag per audio language, e.g. -gerdub: keep the language part
			_dub_flag="${1#--}"
			dub_lang="${_dub_flag#-}"
			dub_lang="${dub_lang%dub}"
			mode=dub
			;;
		--skip) skip_intro=1 ;;
		-subs | --subs) subs_on=1 ;;
		--sub-lang)
			[ $# -lt 2 ] && die "missing argument!"
			sub_lang=$2
			subs_on=1
			shift
			;;
		-engsub | --engsub | -gersub | --gersub | -fresub | --fresub | -spasub | --spasub | \
			-itasub | --itasub | -porsub | --porsub | -rusub | --rusub | -arasub | --arasub | \
			-allsub | --allsub)
			# one flag per subtitle language, e.g. -gersub: keep the language part
			_sub_flag="${1#--}"
			sub_lang="${_sub_flag#-}"
			sub_lang="${sub_lang%sub}"
			subs_on=1
			;;
		--list-subs) list_subs=1 ;;
		--no-detach) no_detach=1 ;;
		--check-deps) do_check_deps=1 ;;
		-V | --version) version_info ;;
		-h | --help) help_info ;;
		-U | --update)
			branch=$repo_branch
			update_script
			;;
		--syncplay)
			case "$os_id" in
				macos) player_function="/Applications/Syncplay.app/Contents/MacOS/syncplay" ;;
				windows)
					PATH="$PATH:/c/Program Files (x86)/Syncplay/"
					player_function="syncplay.exe"
					;;
				*) player_function="syncplay" ;;
			esac
			;;
		*) query="$query $1" ;;
	esac
	shift
done

query=$(printf '%s' "$query" | sed 's|^ *||;s| *$||')

# the stream itself usually offers both audio tracks and the player picks the
# original by default, so say which language is wanted
case "$mode" in
	dub) audio_lang="eng,en" ; audio_lang_short=en ;;
	*) audio_lang="jpn,ja" ; audio_lang_short=ja ;;
esac

if [ "$mode" = dub ] && [ "$dub_lang" != eng ]; then
	case "$dub_lang" in
		ger) dub_name=German ;;
		fre) dub_name=French ;;
		spa) dub_name=Spanish ;;
		ita) dub_name=Italian ;;
		por) dub_name=Portuguese ;;
		rus) dub_name=Russian ;;
		ara) dub_name=Arabic ;;
		*) dub_name=$dub_lang ;;
	esac
	die "No $dub_name dub here: the sites this build can read only carry English dubs, and the ones that have more stream through players that need a browser. Use -dub for English or -sub."
fi

case "$menu_program" in
	fzf) dep_ch_failover "fzf" >/dev/null 2>&1 || menu_program=none ;;
esac

# ---- player resolution, per platform ----
if [ -z "$player_function" ]; then
	case "$os_id" in
		android) player_function="${_NIME_PLAYER:-android_mpv}" ;;
		ish) player_function="${_NIME_PLAYER:-iSH}" ;;
		windows) player_function="${_NIME_PLAYER:-$(dep_ch_failover "mpv.exe,vlc.exe")}" ;;
		macos)
			player_function="${_NIME_PLAYER:-$(dep_ch_failover "iina,/Applications/IINA.app/Contents/MacOS/iina-cli,mpv,vlc")}"
			;;
		*)
			player_function="${_NIME_PLAYER:-$(dep_ch_failover "mpv,$HOME/.local/share/flatpak/app/io.mpv.Mpv/,/var/lib/flatpak/app/io.mpv.Mpv/,vlc")}"
			;;
	esac
fi

case "$player_function" in
	vlc)
		case "$os_id" in
			android) player_function=android_vlc ;;
			windows) player_function=vlc.exe ;;
			ish) player_function=iSH ;;
			*) player_function=vlc ;;
		esac
		;;
esac

# no player at all: stay useful by printing the resolved stream
if [ -z "$player_function" ]; then
	[ "$do_check_deps" = 1 ] || warn "No player found (mpv or vlc). The stream url will be printed."
	player_function=print
fi

if [ "$do_check_deps" = 1 ]; then
	check_deps
	exit 0
fi

case "$player_function" in
	print | android_mpv | android_vlc | iSH) ;;
	download) dep_ch_failover "yt-dlp,ffmpeg" >/dev/null || die "Neither yt-dlp nor ffmpeg found" ;;
	*flatpak*mpv*) dep_ch flatpak ;;
	*yncpla*)
		if [ -x "$player_function" ]; then :; else
			command -v syncplay >/dev/null 2>&1 || die "Syncplay not found"
		fi
		;;
	*) dep_ch "$player_function" ;;
esac

# ctrl-c stops the whole run, not just the episode in front of it: without the
# exit the handler returns and the episode loop carries on to the next one
on_interrupt() {
	trap - INT HUP TERM
	printf '\r\033[2K' >&2
	player_stop
	[ -n "${_tmpd:-}" ] && [ -d "$_tmpd" ] && rm -rf "$_tmpd"
	rm -f "${histfile}.new"
	tput sgr0 2>/dev/null
	printf '\033[1;33mStopped\033[0m\n' >&2
	exit 130
}
trap on_interrupt INT HUP TERM

info "_nime $version, $(mode_word)"

# ---------------------------------------------------------------------------
# pick an anime
# ---------------------------------------------------------------------------

if [ "$source" = history ]; then
	[ -s "$histfile" ] || die "No history yet, watch something first"
	_entries=$(awk -F'\t' 'NF>=4 { printf "%s\t%s - episode %s\t%s\n", $3, $4, $1, $2 }' "$histfile")

	if [ -n "$index" ]; then
		_sel=$(printf '%s\n' "$_entries" | sed -n "${index}p")
	else
		_sel=$(nth "Select anime" "" "$_entries")
	fi
	[ -z "$_sel" ] && die "Invalid selection"

	_sel_title=$(printf '%s' "$_sel" | cut -f 2)
	provider=$(printf '%s' "$_sel" | cut -f 3)
	anime_id=$(printf '%s' "$_sel" | cut -f 1)
	anime_title=$(printf '%s' "$_sel_title" |
		sed -E 's# \((animesuge|anichan)\)##; s| - episode [^ ]*$||')
	ep_no=$(printf '%s' "$_sel_title" | sed -nE 's|.* - episode ([^ ]*)$|\1|p')
	[ -z "$provider" ] && die "History entry is broken, delete it with -D"

	load_episode_maps || die "Could not load episodes for that entry"
else
	if [ -z "$query" ]; then
		query=$(ask_query)
		query=$(printf '%s' "$query" | sed 's|^ *||;s| *$||')
		[ -z "$query" ] && die "No search term given"
	fi
	info "Searching for '$query'..."
	_enc_query=$(printf '%s' "$query" | sed 's| |+|g')
	results=$(search_all_sources "$_enc_query")
	[ -z "$results" ] && die "No results found for '$query'"

	if [ -n "$index" ]; then
		_sel=$(printf '%s\n' "$results" | sed -n "${index}p")
	else
		_sel=$(nth "Select anime" "" "$results")
	fi
	[ -z "$_sel" ] && die "Invalid anime selection"

	anime_id=$(printf '%s' "$_sel" | cut -f 1)
	anime_title=$(printf '%s' "$_sel" | cut -f 4)
	[ -z "$anime_title" ] && anime_title=$(printf '%s' "$_sel" | cut -f 2)
	provider=$(printf '%s' "$_sel" | cut -f 3)
	[ -z "$provider" ] && provider=animesuge

	if [ "$provider" = animesuge ]; then
		_resolved=$(as_anime_id "$anime_id") || die "Could not open that anime"
		[ -z "$_resolved" ] && die "Could not read the anime id"
		anime_id=$_resolved
	fi

	load_episode_maps || die "No episodes found"
fi

if [ -z "$ep_no" ]; then
	ep_no=$(nth "Select episode" "" "$(printf '%s\n' "$episode_maps" | awk -F'\t' -v multi="${season_total:-1}" '{ printf "%s\t%s\n", $1, (multi > 1 && $5 != "" ? $5 : "episode " $1) }')" | cut -f 1)
	[ -z "$ep_no" ] && die "Invalid episode selection"
fi

play "$ep_no"

# ---------------------------------------------------------------------------
# after playback
# ---------------------------------------------------------------------------

while [ "$player_function" != download ] && [ "$player_function" != print ]; do
	_cmd=$(nth "Playing $ep_label of $anime_title" "" \
		"$(printf 'next\tnext\nreplay\treplay\nprevious\tprevious\nselect\tselect\nquit\tquit')" | cut -f 1)
	case "$_cmd" in
		next) ep_no=$(printf '%s\n' "$ep_list" | sed -n "/^${ep_no}$/{n;p;}") ;;
		previous) ep_no=$(printf '%s\n' "$ep_list" | sed -n "/^${ep_no}$/{g;1!p;};h") ;;
		replay)
			video_link="$replay"
			refr="https://megaplay.buzz/"
			play_episode
			continue
			;;
		select) ep_no=$(nth "Select episode" "" "$(printf '%s\n' "$episode_maps" | awk -F'\t' -v multi="${season_total:-1}" '{ printf "%s\t%s\n", $1, (multi > 1 && $5 != "" ? $5 : "episode " $1) }')" | cut -f 1) ;;
		*) break ;;
	esac
	[ -z "$ep_no" ] && {
		warn "Out of range"
		break
	}
	play "$ep_no"
done

	# leaving the menu closes the window the episode was playing in
	player_stop

rm -f "${histfile}.new"

# _nime
