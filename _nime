[ "${_NIME_COLOR:-1}" = 0 ] && {
	die() {
		clear_status
		printf '%s\n' "$*" >&2
		exit 1
	}
	info() {
		status_lines=$((status_lines + 1))
		printf '%s\n' "$*" >&2
	}
	warn() {
		status_lines=$((status_lines + 1))
		printf '%s\n' "$*" >&2
	}
}

dep_ch() {
	for _dep in "$@"; do
		command -v "$_dep" >/dev/null 2>&1 ||
			die "Program $_dep not found. Install it and try again."
	done
}

# dep_ch_failover "a,b,c" -> first program that exists
dep_ch_failover() {
	[ -z "$1" ] && return 1
	for _dep in $(printf '%s' "$1" | tr ',' ' '); do
		if command -v "$_dep" >/dev/null 2>&1; then
			printf '%s' "$_dep"
			return 0
		fi
		[ -x "$_dep" ] && {
			printf '%s' "$_dep"
			return 0
		}
	done
	return 1
}

# ---------------------------------------------------------------------------
# platform detection
# ---------------------------------------------------------------------------

# android | windows | ish | macos | linux
detect_os() {
	_u=$(uname -a 2>/dev/null)
	case "$_u" in
		*ndroid*) printf 'android' ;;
		*MINGW* | *WSL2* | *Msys*) printf 'windows' ;;
		*ISH* | *ish*) printf 'ish' ;;
		*Darwin*) printf 'macos' ;;
		*) printf 'linux' ;;
	esac
}

os_id=$(detect_os)

# the openssl command has to work, not merely exist: on Termux the package named
# openssl is the library, the command line tool is a separate package
openssl_ok() {
	# the same decoding the stream payload goes through, so a working command is
	# one that decodes, not merely one that exists
	printf 'aGVsbG8=' | openssl base64 -d -A 2>/dev/null | grep -q 'hello'
}

check_deps() {
	printf 'required:\n'
	for _d in $req_deps; do
		if [ "$_d" = openssl ] && ! openssl_ok; then
			printf '  MISSING  openssl (the command, not the library)\n'
		elif command -v "$_d" >/dev/null 2>&1; then
			printf '  ok       %s\n' "$_d"
		else
			printf '  MISSING  %s\n' "$_d"
		fi
	done
	printf 'optional:\n'
	for _d in $opt_deps; do
		if command -v "$_d" >/dev/null 2>&1; then
			printf '  ok       %s\n' "$_d"
		else
			printf '  absent   %s\n' "$_d"
		fi
	done
	if [ "$os_id" = android ]; then
		if command -v am >/dev/null 2>&1; then
			printf 'android:\n  ok       am\n'
		else
			printf 'android:\n  MISSING  am (pkg install termux-am)\n'
		fi
		openssl_ok || printf '  MISSING  openssl-tool (pkg install openssl-tool)\n'
		_shared=""
		for _d in /storage/emulated/0/Download /storage/emulated/0; do
			[ -w "$_d" ] && { _shared=1; break; }
		done
		[ -z "$_shared" ] && printf '  no shared storage: termux-setup-storage is needed to play\n'
	fi
	case "$player_function" in
		'') printf 'player:\n  none found, the stream url will be printed\n' ;;
		print) printf 'player:\n  none found, the stream url will be printed\n' ;;
		*) printf 'player:\n  %s\n' "$player_function" ;;
	esac
	# which app actually receives the stream, not just how it is sent
	if [ "$player_function" = android_mpv ]; then
		if android_app org.videolan.vlc; then
			printf '  the VLC app is installed and opens the stream\n'
		elif android_app is.xyz.mpv; then
			printf '  the mpv app is installed and opens the stream\n'
		else
			printf '  no player app, the Play Store opens for VLC\n'
		fi
	fi
}

# ---------------------------------------------------------------------------
# http
# ---------------------------------------------------------------------------

base_as="https://animesuge.cz"
base_ac="https://anichan.to"
agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36"

# a source this network cannot reach is remembered for the rest of the run.
# asking it again on every request is how a search that should take a second
# spent a minute: one dead base is dozens of attempts, each with curl's own
# error line, and the other source was answering the whole time
as_down=0
as_fail=0
ac_down=0
ac_fail=0

# http_get <url> [referer] [xhr]
http_get() {
	_url=$1
	_ref=$2
	_xhr=$3

	# which source the url belongs to, so a failure can be remembered against it
	_side=""
	case "$_url" in
		"$base_as"*) _side=animesuge ;;
		"$base_ac"*) _side=anichan ;;
	esac
	case "$_side" in
		animesuge) [ "$as_down" = 1 ] && return 1 ;;
		anichan) [ "$ac_down" = 1 ] && return 1 ;;
	esac

	# curl's error lines are not something to read while searching, and a request
	# that hangs on a phone should give up at the connection, not at the payload
	set -- -sL -A "$agent" --connect-timeout 4 --max-time 25
	[ -n "$_ref" ] && set -- "$@" -e "$_ref"
	[ -n "$_xhr" ] && set -- "$@" -H "X-Requested-With: XMLHttpRequest"
	if curl "$@" "$_url"; then
		case "$_side" in
			animesuge) as_fail=0 ;;
			anichan) ac_fail=0 ;;
		esac
		return 0
	fi

	# two failures in a row, so one dropped packet does not lose a source
	case "$_side" in
		animesuge)
			as_fail=$((as_fail + 1))
			[ "$as_fail" -ge 2 ] && as_down=1
			;;
		anichan)
			ac_fail=$((ac_fail + 1))
			[ "$ac_fail" -ge 2 ] && ac_down=1
			;;
	esac
	return 1
}

# turn JSON-escaped payloads (\", \/, \n) back into plain text
unescape() {
	sed -e 's|\\r\\n| |g' -e 's|\\n| |g' -e 's|\\r| |g' -e 's|\\"|"|g' -e 's|\\/|/|g'
}

html_decode() {
	sed -e "s|&#039;|'|g" -e "s|&#39;|'|g" -e 's|&quot;|"|g' -e 's|&amp;|\&|g' \
		-e 's|&lt;|<|g' -e 's|&gt;|>|g'
}

# a search term has to be escaped before it goes into a URL: curl reads a space
# as a broken address and hands back nothing, which looked like the source not
# having the show at all. a plus is already how a space is written in a query
# string, so one is turned back into a space and then into a plus again, and
# an escaped term can be passed through as often as needed
urlenc() {
	printf '%s' "$1" | tr '+' ' ' | LC_ALL=C awk '
		BEGIN { for (i = 1; i < 256; i++) ch[sprintf("%c", i)] = i }
		{
			n = length($0)
			for (i = 1; i <= n; i++) {
				c = substr($0, i, 1)
				if (c ~ /[A-Za-z0-9._~-]/) printf "%s", c
				else if (c == " ") printf "+"
				else printf "%%%02X", ch[c]
			}
		}'
}

# ---------------------------------------------------------------------------
# menu: reads "value<TAB>label" lines, prints the chosen value
# ---------------------------------------------------------------------------

nth() {
	_prompt=$1
	_multi=$2
	_list=$3
	[ -z "$_list" ] && return 1

	if [ "$menu_program" = fzf ]; then
		# no --height: fzf takes over the whole terminal on its own screen and
		# hands it back on exit, so the menu feels like its own window
		if [ -n "$_multi" ]; then
			printf '%s\n' "$_list" | fzf --reverse --no-sort --delimiter="$TAB" \
				--with-nth=2 -m $menu_extra_flags --prompt "$_prompt > "
		else
			printf '%s\n' "$_list" | fzf --reverse --no-sort --delimiter="$TAB" \
				--with-nth=2 $menu_extra_flags --prompt "$_prompt > "
		fi
		return
	fi

	printf '%s\n' "$_list" | awk -F'\t' '{printf "%3d) %s\n", NR, $2}' >&2
	printf '%s: ' "$_prompt" >&2
	read -r _sel || return 1
	for _choice in $_sel; do
		case "$_choice" in
			'' | *[!0-9]*) return 1 ;;
		esac
		printf '%s\n' "$_list" | sed -n "${_choice}p"
	done
}

# ask for a search term when _nime is started with no query
ask_query() {
	if [ "$menu_program" = fzf ]; then
		printf '' | fzf --print-query --reverse --prompt 'Search anime > ' \
			--header 'type a title and press enter, esc to quit' 2>/dev/null | head -n 1
	else
		printf 'Search anime: ' >&2
		read -r _q || _q=""
		printf '%s' "$_q"
	fi
}

# ---------------------------------------------------------------------------
# animesuge.cz
# ---------------------------------------------------------------------------

as_search() {
	_page=$(http_get "$base_as/ajax/anime/search?keyword=$(urlenc "$1")" "" xhr) || return 1
	[ -z "$_page" ] && return 1
	printf '%s' "$_page" | unescape | tr '\n' ' ' |
		sed 's|<a class="item" |\n<a class="item" |g' |
		while IFS= read -r _rec || [ -n "$_rec" ]; do
			_slug=$(printf '%s' "$_rec" | sed -nE 's|.*href="[^"]*/anime/([^"]*)".*|\1|p' | head -n 1)
			_name=$(printf '%s' "$_rec" | sed -nE 's|.*<div class="name"[^>]*>([^<]*)</div>.*|\1|p')
			[ -z "$_slug" ] && continue
			[ -z "$_name" ] && _name=$_slug
			printf '%s\t%s\n' "$_slug" "$(printf '%s' "$_name" | html_decode)"
		done
}

as_anime_id() {
	_page=$(http_get "$base_as/anime/$1") || return 1
	printf '%s' "$_page" | grep -oE 'data-id="[0-9]+"' | head -n 1 | grep -oE '[0-9]+'
}

as_episode_maps() {
	_raw=$(http_get "$base_as/ajax/episode/list/$1" "" xhr) || return 1
	[ -z "$_raw" ] && return 1
	printf '%s' "$_raw" | unescape | tr '\n' ' ' |
		sed 's|<a href="#" |\n<a href="#" |g' |
		while IFS= read -r _rec || [ -n "$_rec" ]; do
			_ep=$(printf '%s' "$_rec" | sed -nE 's|.*data-slug="([^"]*)".*|\1|p')
			_ids=$(printf '%s' "$_rec" | sed -nE 's|.*data-ids="([^"]*)".*|\1|p')
			_sub=$(printf '%s' "$_rec" | sed -nE 's|.*data-sub="([01])".*|\1|p')
			_dub=$(printf '%s' "$_rec" | sed -nE 's|.*data-dub="([01])".*|\1|p')
			{ [ -z "$_ep" ] || [ -z "$_ids" ]; } && continue
			if [ "${2:-$mode}" = dub ]; then
				[ "$_dub" = 1 ] || continue
			else
				[ "$_sub" = 1 ] || continue
			fi
			printf '%s\t%s\n' "$_ep" "$_ids"
		done
}

# as_servers <ids> [sub|dub]: the list holds one group per language, and the sub
# group comes first, so picking the first server blindly gave a dubbed episode
# the subbed stream
as_servers() {
	_raw=$(http_get "$base_as/ajax/server/list?servers=$1" "" xhr) || return 1
	[ -z "$_raw" ] && return 1
	_group=$(printf '%s' "$_raw" | unescape | tr '\n' ' ' |
		sed 's|data-type="\([a-z]*\)"|\n@TYPE@\1@|g' |
		awk -v want="${2:-$mode}" '
			/^@TYPE@/ {
				split($0, p, "@")
				cur = p[3]
				sub(/^@TYPE@[a-z]*@/, "")
			}
			cur == want { print }
		')
	# a page without any markers carries a single group, so that group is all there
	# is; a page that marks its groups and has no dub one genuinely has no dub here,
	# and handing the subbed servers over instead was what made episodes play subbed
	if [ -z "$_group" ]; then
		case "$_raw" in
			*data-type=*) : ;;
			*) _group=$(printf '%s' "$_raw" | unescape | tr '\n' ' ') ;;
		esac
	fi
	printf '%s' "$_group" |
		sed 's|<div class="server"|\n<div class="server"|g' |
		while IFS= read -r _rec || [ -n "$_rec" ]; do
			_link=$(printf '%s' "$_rec" | sed -nE 's|.*data-link-id="([^"]*)".*|\1|p')
			_name=$(printf '%s' "$_rec" | sed -nE 's|.*<span>([^<]*)</span>.*|\1|p')
			[ -z "$_link" ] && continue
			[ -z "$_name" ] && _name=server
			printf '%s\t%s\n' "$_name" "$_link"
		done
}

as_embed() {
	_raw=$(http_get "$base_as/ajax/server?get=$1" "" xhr) || return 1
	printf '%s' "$_raw" | unescape |
		sed -nE 's|.*"url":[[:space:]]*"([^"]+)".*|\1|p' | head -n 1
}

# ---------------------------------------------------------------------------
# anichan.to
# ---------------------------------------------------------------------------

# the suggest endpoint answers with eight titles at most, which left most shows
# out of the list; the search endpoint behind it returns forty, and carries the
# year as well, so the oldest-first order costs no extra requests
ac_search() {
	_page=$(http_get "$base_ac/api/search?q=$(urlenc "$1")") || return 1
	[ -z "$_page" ] && return 1
	printf '%s' "$_page" | tr -d '\n' | sed 's|": |":|g; s|{"id":|\n{"id":|g' |
		while IFS= read -r _rec || [ -n "$_rec" ]; do
			# music videos and things that have not aired are not watchable, and
			# the search hands them over all the same
			case "$_rec" in
				*'"format":"MUSIC"'* | *'"status":"NOT_YET_RELEASED"'*) continue ;;
			esac
			_id=$(printf '%s' "$_rec" | sed -nE 's|^\{"id":([0-9]+).*|\1|p')
			[ -z "$_id" ] && continue
			_name=$(printf '%s' "$_rec" | sed -nE 's|.*"title":"([^"]*)".*|\1|p')
			[ -z "$_name" ] && _name=$_id
			_year=$(printf '%s' "$_rec" |
				sed -nE 's|.*"startDate":\{"year":([0-9]{4}).*|\1|p')
			printf '%s\t%s\t%s\n' "$_id" "$(printf '%s' "$_name" | html_decode)" "$_year"
		done
}

ac_eps_count() {
	_raw=$(http_get "$base_ac/api/watch/episodes?anilistId=$1") || return 1
	_n=$(printf '%s' "$_raw" | sed -nE 's|.*"episodes":[[:space:]]*([0-9]+).*|\1|p' | head -n 1)
	if [ -z "$_n" ]; then
		_raw=$(http_get "$base_ac/api/catalog/anime/$1") || return 1
		_n=$(printf '%s' "$_raw" | sed -nE 's|.*"episodes":[[:space:]]*([0-9]+).*|\1|p' | head -n 1)
	fi
	printf '%s' "$_n"
}

ac_episode_maps() {
	_n=$(ac_eps_count "$1")
	[ -z "$_n" ] && return 1
	_i=1
	while [ "$_i" -le "$_n" ]; do
		printf '%s\t-\n' "$_i"
		_i=$((_i + 1))
	done
}

# ---------------------------------------------------------------------------
# dub availability
# ---------------------------------------------------------------------------

# animesuge marks every episode with data-sub / data-dub, so one request tells
# us whether the show is dubbed at all
as_has_dub() {
	_id=$(as_anime_id "$1") || return 1
	[ -z "$_id" ] && return 1
	[ -n "$(as_episode_maps "$_id" dub 2>/dev/null | head -n 1)" ]
}

# anichan does not publish the flags, so ask the player for the dub of episode
# one and see whether it hands back a playlist
ac_has_dub() {
	_embed="https://megaplay.buzz/stream/ani/$1/1/dub"
	_page=$(curl -sSL -A "$agent" --max-time 12 -e "$base_ac" "$_embed" 2>/dev/null)
	_fid=$(printf '%s' "$_page" | grep -oE 'data-id="[0-9]+"' | head -n 1 | grep -oE '[0-9]+')
	[ -z "$_fid" ] && return 1
	_src=$(curl -sSL -A "$agent" --max-time 12 -e "$_embed" \
		-H "X-Requested-With: XMLHttpRequest" \
		"https://megaplay.buzz/stream/getSourcesNew?id=$_fid" 2>/dev/null)
	[ -z "$_src" ] && return 1
	_src=$(printf '%s' "$_src" | unescape)
	_enc=$(printf '%s' "$_src" | sed -nE 's|.*"enc":[[:space:]]*"([^"]+)".*|\1|p' | head -n 1)
	[ -n "$_enc" ] && _src=$(decrypt_payload "$_enc")
	case "$_src" in
		*'.m3u8'*) return 0 ;;
	esac
	return 1
}

# compare two titles loosely, so a source switch never lands on another show.
# sites spell things differently ("shippuuden" / "shippuden"), so this scores
# how many words of the shorter title also appear in the longer one
titles_match() {
	_a=$(printf '%s' "$1" | tr 'A-Z' 'a-z' | sed 's|[^a-z0-9]| |g; s|  *| |g; s|^ ||; s| $||')
	_b=$(printf '%s' "$2" | tr 'A-Z' 'a-z' | sed 's|[^a-z0-9]| |g; s|  *| |g; s|^ ||; s| $||')
	[ -z "$_a" ] && return 1
	[ -z "$_b" ] && return 1
	[ "$_a" = "$_b" ] && return 0
	awk -v a="$_a" -v b="$_b" 'BEGIN {
		# sources write some titles apart, so "DAN DA DAN" and "Dandadan" are
		# the same show and have to be recognised as one before the word count
		fa = a; fb = b
		gsub(/[^a-z0-9]/, "", fa); gsub(/[^a-z0-9]/, "", fb)
		if (fa != "" && fa == fb) exit 0
		# one title wrapped around the other: "Solo Leveling" and "Solo
		# Leveling Season 2" are the same series, a short word that only looks
		# like the start of a longer one is not
		if (length(fa) >= 5 && length(fb) >= 5) {
			if (index(fb, fa) == 1 || index(fa, fb) == 1) exit 0
		}
		na = split(a, x, " ")
		nb = 0
		m = split(b, y, " ")
		hits = 0
		words = 0
		for (i = 1; i <= na; i++) {
			# short words say nothing: "dan" on its own matched half the source
			if (length(x[i]) < 4) continue
			words++
			for (j = 1; j <= m; j++)
				if (x[i] == y[j]) { hits++; break }
		}
		if (words == 0) exit 1
		exit (hits / words >= 0.8) ? 0 : 1
	}'
}

# look for the show we already picked on the other sources, and switch to the
# first one that actually has it dubbed
# the title with season markers and bracketed tags stripped, so "Show" and
# "Show Season 2" are recognised as the same series
season_base() {
	_b=$(printf ' %s ' "$1" | tr 'A-Z' 'a-z' |
		sed 's/([^)]*)//g; s/\[[^]]*\]//g;
			s/ final season / /g;
			s/ [0-9][0-9]*\(st\|nd\|rd\|th\) season / /g;
			s/ season \(one\|two\|three\|four\|five\|six\|seven\|eight\|nine\|ten\) / /g;
			s/ season[[:space:]]*[0-9][0-9]* / /g;
			s/ part[[:space:]]*[0-9][0-9]* / /g')
	printf '%s' "$_b" | sed 's/[^a-z0-9]/ /g; s/  */ /g; s/^ //; s/ $//'
}

# which season a title belongs to, one when it says nothing
season_no() {
	_t=$(printf '%s' "$1" | tr 'A-Z' 'a-z')
	_n=$(printf '%s' "$_t" | sed -n 's/.*season[[:space:]]*\([0-9][0-9]*\).*/\1/p' | head -n 1)
	[ -z "$_n" ] && _n=$(printf '%s' "$_t" | sed -n 's/.*\([0-9][0-9]*\)\(st\|nd\|rd\|th\)[[:space:]]*season.*/\1/p' | head -n 1)
	if [ -z "$_n" ]; then
		_w=$(printf '%s' "$_t" | sed -n 's/.*season[[:space:]]*\(one\|two\|three\|four\|five\|six\|seven\|eight\|nine\|ten\).*/\1/p' | head -n 1)
		case "$_w" in
			one) _n=1 ;; two) _n=2 ;; three) _n=3 ;; four) _n=4 ;; five) _n=5 ;;
			six) _n=6 ;; seven) _n=7 ;; eight) _n=8 ;; nine) _n=9 ;; ten) _n=10 ;;
		esac
	fi
	printf '%s' "${_n:-1}"
}

# the same show, not just a show whose title starts the same way: the fallback
# source is searched by title, and a loose match there played a different series
# ("Cyberpunk: Edgerunners 2" answered a lookup for the first one)
same_series() {
	_a=$(season_base "$1" | tr -d ' ')
	_b=$(season_base "$2" | tr -d ' ')
	[ -n "$_a" ] && [ "$_a" = "$_b" ]
}

# a search term the sites accept: plain ascii words joined with plus. one of
# them answers 400 to anything else, which silently kills a lookup
season_query() {
	printf '%s' "$1" | LC_ALL=C sed 's/[^A-Za-z0-9 ]/ /g; s/  */ /g; s/^ //; s/ $//' | tr ' ' '+'
}

# ---------------------------------------------------------------------------
# one player window
# ---------------------------------------------------------------------------
# a second episode should replace the first inside the same window, and quitting
# should close it, so the player is given a control socket when one can be had
player_sock=""
player_ipc=0
player_running=0

player_ipc_setup() {
	[ "$player_ipc" = 1 ] && return 0
	# a windows build of mpv takes a named pipe there, which the client below
	# cannot open, so windows gets one window per episode
	case "$(uname -s 2>/dev/null)" in
		MSYS* | MINGW* | CYGWIN* | Windows*) return 1 ;;
	esac
	command -v python3 >/dev/null 2>&1 || return 1
	player_sock="${TMPDIR:-/tmp}/_nime_player.$$.sock"
	rm -f "$player_sock"
	player_ipc=1
}

# quoting for the json mpv expects
json_escape() {
	printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

# player_cmd <json>: hand one command to the player
player_cmd() {
	[ -n "$player_sock" ] && [ -S "$player_sock" ] || return 1
	python3 - "$player_sock" "$1" >/dev/null 2>&1 <<'PY'
import socket, sys
s = socket.socket(socket.AF_UNIX)
s.settimeout(3)
try:
    s.connect(sys.argv[1])
    s.sendall((sys.argv[2] + chr(10)).encode())
    s.recv(4096)
except Exception:
    sys.exit(1)
PY
}

# close the player and drop the socket
player_stop() {
	player_cmd '{"command":["quit"]}'
	sleep 0.2
	rm -f "$player_sock"
	player_running=0
}

# every result for a query, not just the handful the search box shows. the page
# writes one card per result with its link, its id and its title, so each card is
# read on its own: pulled out separately the three lists could drift apart and a
# card the page wrote differently shifted every title after it onto the wrong
# slug, which is how a search ended up with rows that led nowhere
as_search_all() {
	_p=1
	while [ "$_p" -le 3 ]; do
		_page=$(http_get "$base_as/filter?keyword=$(urlenc "$1")&page=$_p") || return 1
		[ -z "$_page" ] && break
		_found=$(printf '%s' "$_page" | unescape | tr -d '\r' | tr '\n' ' ' |
			sed 's|<a class="poster|\n@CARD@|g' |
			while IFS= read -r _card; do
				case "$_card" in
					@CARD@*) ;;
					*) continue ;;
				esac
				_sl=$(printf '%s' "$_card" |
					sed -nE 's|^@CARD@[^>]*href="[^"]*/anime/([^/"]+).*|\1|p')
				[ -z "$_sl" ] && continue
				_no=$(printf '%s' "$_card" | sed -nE 's|.*data-tip="([0-9]+)".*|\1|p')
				_nm=$(printf '%s' "$_card" |
					sed -nE 's|.*<div class="name">[^<]*<a [^>]*>([^<]*)</a>.*|\1|p' |
					sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
				[ -z "$_nm" ] && _nm=$_sl
				printf '%s\t%s\t%s\n' "$_sl" "$(printf '%s' "$_nm" | html_decode)" "$_no"
			done)
		[ -z "$_found" ] && break
		printf '%s\n' "$_found"
		_p=$((_p + 1))
	done
}

# the seasons of the show we picked, one line each: id, title, season number,
# and 1 when it is the entry the user chose
provider_seasons() {
	_base=$(season_base "$2")
	[ -z "$_base" ] && return 1
	case "$provider" in
		animesuge)
			as_search_all "$1" | while IFS="$TAB" read -r _slug _name _sid; do
				[ "$(season_base "$_name")" = "$_base" ] || continue
				[ -z "$_sid" ] && _sid=$(as_anime_id "$_slug")
				[ -z "$_sid" ] && continue
				_flag=0
				[ "$_name" = "$anime_title" ] && _flag=1
				printf '%s\t%s\t%s\t%s\n' "$_sid" "$_name" "$(season_no "$_name")" "$_flag"
			done
			;;
		anichan)
			ac_search "$1" | while IFS="$TAB" read -r _sid _name; do
				[ "$(season_base "$_name")" = "$_base" ] || continue
				_flag=0
				[ "$_name" = "$anime_title" ] && _flag=1
				printf '%s\t%s\t%s\t%s\n' "$_sid" "$_name" "$(season_no "$_name")" "$_flag"
			done
			;;
	esac
}

# every episode of every season in one list. the label stays a plain number,
# because that is what -e, ranges and next/previous work with; the fifth field
# keeps the "S2 E5" wording for the menus
merge_season_maps() {
	# search for the series without its season marker, so every season is reachable
	_seasons=$(provider_seasons "$(season_query "$(season_base "$anime_title")")" "$anime_title")
	[ -z "$_seasons" ] && return 1
	_seasons=$(printf '%s\n' "$_seasons" | sort -t"$TAB" -k3,3n -k4,4r | awk -F"$TAB" '!seen[$3]++')
	[ -z "$_seasons" ] && return 1

	_tmp="${TMPDIR:-/tmp}/_nime_seasons.$$"
	printf '%s\n' "$_seasons" >"$_tmp"
	_off=0
	_used=0
	_blocks=""
	# ask every season for its episodes at once instead of one after another
	while IFS="$TAB" read -r _sid _stitle _sno _flag; do
		[ -z "$_sid" ] && continue
		( provider_episode_maps "$_sid" >"${_tmp}.${_sid}" ) &
	done <"$_tmp"
	wait

	while IFS="$TAB" read -r _sid _stitle _sno _flag; do
		[ -z "$_sid" ] && continue
		_maps=$(cat "${_tmp}.${_sid}" 2>/dev/null)
		[ -z "$_maps" ] && continue
		_cnt=$(printf '%s\n' "$_maps" | grep -c .)
		_used=$((_used + 1))
		_blocks="${_blocks}$(printf '%s\n' "$_maps" |
			awk -F"$TAB" -v off="$_off" -v id="$_id" -v s="$_sno" \
				'{ printf "%d\t%s\t%s\t%s\tS%s E%s\n", NR+off, $2, id, $1, s, $1 }')
"
		_off=$((_off + _cnt))
	done <"$_tmp"
	rm -f "$_tmp" "${_tmp}".*
	[ "$_off" -gt 0 ] || return 1
	season_total=$_used
	# command substitution drops the newline the last block ended with, so the
	# menus do not show a blank row after the final episode
	episode_maps=$(printf '%s' "$_blocks")
	[ "$_used" -gt 1 ]
}

# how to name an episode in prompts: "S2 E5" once seasons are merged
ep_display() {
	_row=$(printf '%s\n' "$episode_maps" | grep -m 1 "^$1${TAB}")
	_l=$(printf '%s' "$_row" | cut -f 5)
	if [ "${season_total:-1}" -gt 1 ] && [ -n "$_l" ]; then
		printf '%s' "$_l"
	else
		printf 'Episode %s' "$1"
	fi
}

find_dub_source() {
	_q=$(season_query "$anime_title")
	for _src in animesuge anichan; do
		[ "$_src" = "$provider" ] && continue
		case "$_src" in
			animesuge)
				_line=$(as_search "$_q" | head -n 1)
				[ -z "$_line" ] && continue
				_ctitle=$(printf '%s' "$_line" | cut -f 2)
				titles_match "$anime_title" "$_ctitle" || continue
				# never jump to another season of the same series
				[ "$(season_no "$anime_title")" = "$(season_no "$_ctitle")" ] || continue
				info "No dub here, looking for one..."
				if as_has_dub "$(printf '%s' "$_line" | cut -f 1)"; then
					_id=$(as_anime_id "$(printf '%s' "$_line" | cut -f 1)")
					[ -z "$_id" ] && continue
					provider=animesuge
					anime_id=$_id
					info "Found it dubbed: $(printf '%s' "$_line" | cut -f 2)"
					return 0
				fi
				;;
			anichan)
				_line=$(ac_search "$_q" | head -n 1)
				[ -z "$_line" ] && continue
				_ctitle=$(printf '%s' "$_line" | cut -f 2)
				titles_match "$anime_title" "$_ctitle" || continue
				[ "$(season_no "$anime_title")" = "$(season_no "$_ctitle")" ] || continue
				_id=$(printf '%s' "$_line" | cut -f 1)
				info "No dub here, looking for one..."
				if ac_has_dub "$_id"; then
					provider=anichan
					anime_id=$_id
					info "Found it dubbed: $(printf '%s' "$_line" | cut -f 2)"
					return 0
				fi
				;;
		esac
	done
	return 1
}

# ---------------------------------------------------------------------------
# provider dispatch
# ---------------------------------------------------------------------------

# release year of a result, remembered on disk because it costs a request and
# does not change. empty when the source does not say
release_year() {
	_key="$1:$2"
	_hit=$(grep -m 1 "^${_key}${TAB}" "$year_cache" 2>/dev/null | cut -f 2)
	if [ -n "$_hit" ]; then
		printf '%s' "$_hit"
		return
	fi
	case "$1" in
		animesuge)
			_page=$(http_get "$base_as/anime/$2")
			# the first date on the page is the show's own, later ones are sequels
			_y=$(printf '%s' "$_page" | grep -o 'itemprop="dateCreated"[^<]*' | head -n 1 |
				grep -oE '(19|20)[0-9]{2}' | head -n 1)
			;;
		anichan)
			_json=$(http_get "$base_ac/api/catalog/anime/$2")
			# the catalog carries every related entry too, and the show's own date
			# comes first
			_y=$(printf '%s' "$_json" | grep -o '"startDate":{[^}]*}' | head -n 1 |
				sed -nE 's/.*"year":([0-9]{4}).*/\1/p')
			;;
		esac
	[ -n "$_y" ] && printf '%s\t%s\n' "$_key" "$_y" >>"$year_cache" 2>/dev/null
	printf '%s' "$_y"
}

# only the rows whose title carries the query, so a search does not come back
# with every entry the source happens to associate with it. every word of the
# query has to be in the title, because "chainsaw man" used to answer with
# EAT-MAN, Iron Man and Anpanman on the strength of the one word "man", and
# each of those rows then cost a page fetch of its own. the query is also
# matched with its spacing removed, because the sources write some titles
# apart: "dandadan" never found "DAN DA DAN" and the show was missing from its
# own search. a query that matches nothing that way keeps the looser match
# instead of showing an empty list
relevant_rows() {
	awk -F'\t' -v q="$1" '
		BEGIN {
			n = split(tolower(q), w, "[-+ ,]")
			k = 0
			for (i = 1; i <= n; i++) if (length(w[i]) >= 3) words[++k] = w[i]
			flatq = tolower(q)
			gsub(/[^a-z0-9]/, "", flatq)
		}
		NF >= 3 {
			t = tolower($2)
			flat = t
			gsub(/[^a-z0-9]/, "", flat)
			cnt = 0
			for (i = 1; i <= k; i++) if (index(t, words[i])) cnt++
			full = (length(flatq) >= 3 && index(flat, flatq) > 0)
			if ((k > 0 && cnt == k) || full) {
				every[++ne] = $0
				next
			}
			if (cnt > 0 || (k == 0 && length(flatq) < 2)) some[++ns] = $0
		}
		END {
			if (ne > 0) for (i = 1; i <= ne; i++) print every[i]
			else for (i = 1; i <= ns; i++) print some[i]
		}'
}

# both sources are asked at once and the answers become one list, so a title
# shows up once and nothing has to be chosen up front. each row keeps the id it
# needs for its own source in field 1 and names that source in field 3
search_all_sources() {
	_tmp="${TMPDIR:-/tmp}/_nime_search.$$"
	# the quick search answers with five titles; the filter page behind it has
	# twenty-eight per page and is what the list is built from, so a search for a
	# popular show turns up its films and specials too instead of five of them
	( as_search_all "$1" 2>/dev/null | while IFS="$TAB" read -r _sl _nm _sid; do
		[ -n "$_sl" ] && printf '%s\t%s\tanimesuge\n' "$_sl" "$_nm"
	done >"${_tmp}.a" ) &
	( ac_search "$1" 2>/dev/null | while IFS="$TAB" read -r _id _nm _yr; do
		[ -n "$_id" ] && printf '%s\t%s\tanichan\t%s\n' "$_id" "$_nm" "$_yr"
	done >"${_tmp}.b" ) &
	wait
	_all=$(cat "${_tmp}.a" "${_tmp}.b" 2>/dev/null)
	_pruned=$(printf '%s\n' "$_all" | relevant_rows "$1")
	# a short query like an acronym matches no title at all, so keep the raw
	# answers rather than showing nothing
	[ -z "$_pruned" ] && _pruned=$_all
	printf '%s\n' "$_pruned" >"${_tmp}.in"
	# ask for every year at once, then list the oldest series first so the one to
	# start with sits at the top
	# a long list means one page fetch per row to date it, so they go ten at a
	# time rather than all at once; a year the search already gave is used as is
	_i=0
	while IFS="$TAB" read -r _id _title _prov _known; do
		[ -z "$_id" ] && continue
		_i=$((_i + 1))
		(
			_y=$_known
			[ -z "$_y" ] && _y=$(release_year "$_prov" "$_id")
			printf '%s\t%s\t%s\t%s\t%s\n' "${_y:-9999}" "$_id" "$_title" "$_prov" "$_title" >"${_tmp}.r$_i"
		) &
		[ $((_i % 10)) -eq 0 ] && wait
	done <"${_tmp}.in"
	wait
	# the title the query names comes first and everything else follows, each
	# group oldest first: with the whole list now here, sorting by year alone put
	# an unrelated older show above the one that was asked for
	cat "${_tmp}".r* 2>/dev/null |
		awk -F'\t' -v q="$1" '
			BEGIN {
				f = tolower(q)
				gsub(/[^a-z0-9]/, "", f)
			}
			NF >= 5 {
				t = tolower($3)
				gsub(/[^a-z0-9]/, "", t)
				rank = 3
				if (f != "" && t == f) rank = 0
				else if (f != "" && index(t, f) == 1) rank = 1
				else if (f != "" && index(t, f) > 0) rank = 2
				printf "%d\t%s\t%s\t%s\t%s\t%s\n", rank, $1, $2, $3, $4, $5
			}' |
		sort -t"$TAB" -k1,1n -k2,2n -k5,5 |
		awk -F'\t' 'NF >= 6 {
			key = tolower($4)
			gsub(/[^a-z0-9]/, "", key)
			if (key == "" || key in seen) next
			seen[key] = 1
			label = ($2 == 9999 ? $4 : $4 " (" $2 ")")
			printf "%s\t%s\t%s\t%s\n", $3, label, $5, $6
		}'
	rm -f "${_tmp}.a" "${_tmp}.b" "${_tmp}.in" "${_tmp}".r*
}

provider_episode_maps() {
	case "$provider" in
		animesuge) as_episode_maps "$1" "$mode" ;;
		anichan) ac_episode_maps "$1" ;;
		*) return 1 ;;
	esac
}

provider_embed() {
	# <label>: read the episode row, because a merged list mixes seasons and each
	# season is a separate entry on the site
	_row=$(printf '%s\n' "$episode_maps" | grep -m 1 "^$1${TAB}")
	[ -z "$_row" ] && return 1
	_ids=$(printf '%s' "$_row" | cut -f 2)
	_entry=$(printf '%s' "$_row" | cut -f 3)
	_local=$(printf '%s' "$_row" | cut -f 4)
	[ -z "$_entry" ] && _entry=$anime_id
	[ -z "$_local" ] && _local=$1
	case "$provider" in
		animesuge)
			[ -z "$_ids" ] || [ "$_ids" = "-" ] && return 1
			_servers=$(as_servers "$_ids" "$mode")
			# dub is the point: a missing dub group means this episode has no dub,
			# not that the subbed one will do
			[ -z "$_servers" ] && [ "$mode" != dub ] && _servers=$(as_servers "$_ids" sub)
			[ -z "$_servers" ] && return 1
			_total=$(printf '%s\n' "$_servers" | grep -c .)
			_i=1
			while [ "$_i" -le "$_total" ]; do
				_link=$(printf '%s\n' "$_servers" | sed -n "${_i}p" | cut -f 2)
				if [ -n "$_link" ]; then
					_url=$(as_embed "$_link")
					if [ -n "$_url" ]; then
						printf '%s' "$_url"
						return 0
					fi
				fi
				_i=$((_i + 1))
			done
			return 1
			;;
		anichan)
			printf 'https://megaplay.buzz/stream/ani/%s/%s/%s' "$_entry" "$_local" "$mode"
			;;
		*) return 1 ;;
	esac
}

# ---------------------------------------------------------------------------
# stream resolution
# ---------------------------------------------------------------------------

# MegaPlay returns the stream in an AES-256-CBC blob: the key is a 16 char
# string zero padded to 32 bytes, the iv is a fixed 16 char string.
mp_key_hex="693f4c4d5441783051362c3a7d35305500000000000000000000000000000000"
mp_iv_hex="57303b3237546f6155706c5f50252763"

decrypt_payload() {
	_b=$(printf '%s' "$1" | tr '_-' '/+')
	case $((${#_b} % 4)) in
		2) _b="${_b}==" ;;
		3) _b="${_b}=" ;;
	esac
	printf '%s' "$_b" | openssl base64 -d -A 2>/dev/null |
		openssl enc -d -aes-256-cbc -K "$mp_key_hex" -iv "$mp_iv_hex" 2>/dev/null
}

select_quality() {
	_q=${1%p}
	[ -z "$links" ] && return 1
	case "$_q" in
		best) _result=$(printf '%s\n' "$links" | head -n 1) ;;
		worst) _result=$(printf '%s\n' "$links" | tail -n 1) ;;
		*)
			_result=$(printf '%s\n' "$links" | grep -m 1 -E "^${_q}p* ")
			if [ -z "$_result" ]; then
				warn "$_q not found, defaulting to best"
				_result=$(printf '%s\n' "$links" | head -n 1)
			fi
			;;
	esac
	video_link=$(printf '%s' "$_result" | cut -d '>' -f 2)
}

# pick the subtitle track: $sub_lang, or the one the site marks default
pick_sub() {
	sub_link=""
	sub_code=""
	sub_label=""
	[ -z "$sub_tracks" ] && return 0
	# subtitles stay off until they are asked for
	[ "$subs_on" = 1 ] || return 0

	_sel=""
	case "$sub_lang" in
		'' | default | all | ALL | All)
			_sel=$(printf '%s\n' "$sub_tracks" | awk -F'\t' '$3 == 1 { print; exit }')
			[ -z "$_sel" ] && _sel=$(printf '%s\n' "$sub_tracks" | head -n 1)
			;;
		*)
			# a language code first (eng, ger, spa), then a label (German)
			_sel=$(printf '%s\n' "$sub_tracks" |
				awk -F'\t' -v w="$sub_lang" 'tolower($1) == tolower(w) { print; exit }')
			[ -z "$_sel" ] && _sel=$(printf '%s\n' "$sub_tracks" |
				awk -F'\t' -v w="$sub_lang" 'index(tolower($2), tolower(w)) { print; exit }')
			if [ -z "$_sel" ]; then
				warn "No '$sub_lang' subtitles here, available: $(printf '%s\n' "$sub_tracks" | cut -f 1 | tr '\n' ' ')"
				_sel=$(printf '%s\n' "$sub_tracks" | awk -F'\t' '$3 == 1 { print; exit }')
				[ -z "$_sel" ] && _sel=$(printf '%s\n' "$sub_tracks" | head -n 1)
			fi
			;;
	esac

	sub_code=$(printf '%s' "$_sel" | cut -f 1)
	sub_label=$(printf '%s' "$_sel" | cut -f 2)
	sub_link=$(printf '%s' "$_sel" | cut -f 4)
}

# resolve_episode <id> <ep> : sets video_link, sub_link, links, refr and the skip marks
# the player only answers to its own host as referer; the source pages are not
# accepted and quietly hand back an error page without a file id
load_embed() {
	_embed=$1
	_embed_ref=$(printf '%s' "$_embed" | sed -E 's|^(https?://[^/]+).*|\1|')
	_page=$(http_get "$_embed" "$_embed_ref") || return 1
	_file_id=$(printf '%s' "$_page" | grep -oE 'data-id="[0-9]+"' | head -n 1 | grep -oE '[0-9]+')
	if [ -z "$_file_id" ]; then
		warn "Player page did not expose a file id"
		return 1
	fi

	_host=$(printf '%s' "$_embed" | sed -E 's|^(https?://[^/]+).*|\1|')
	_src=$(http_get "$_host/stream/getSourcesNew?id=$_file_id" "$_embed" xhr) || return 1
	[ -z "$_src" ] && return 1

	_plain=$(printf '%s' "$_src" | unescape)
	_enc=$(printf '%s' "$_plain" | sed -nE 's|.*"enc":[[:space:]]*"([^"]+)".*|\1|p' | head -n 1)

	if [ -n "$_enc" ]; then
		_json=$(decrypt_payload "$_enc")
		[ -z "$_json" ] && {
			if openssl_ok; then
				warn "Could not decrypt the stream payload"
			else
				warn "The stream payload cannot be decrypted without the openssl command"
				case "$os_id" in
					android) warn "On Termux it is a separate package: pkg install openssl-tool" ;;
					*) warn "Install openssl and try again" ;;
				esac
			fi
			return 1
		}
	else
		_json="$_plain"
	fi
	return 0
}

# the episode as it would be played with the original audio, to tell a real dub
# from a source that just hands the same file back under the dub url
sub_embed_for() {
	_saved_mode=$mode
	mode=sub
	_out=$(provider_embed "$1")
	mode=$_saved_mode
	printf '%s' "$_out"
}

# the media id inside a stream url: the same episode re-hosted elsewhere keeps
# its id, so comparing ids catches a dub that is really the original file even
# when the two urls sit on different hosts
media_key() {
	_key=$(printf '%s' "$1" | sed -nE 's|.*/([0-9a-f]{16,})/[^/]+$|\1|p' | head -n 1)
	[ -z "$_key" ] && _key=$1
	printf '%s' "$_key"
}

file_of_embed() {
	_kept_json=$_json
	if ! load_embed "$1" 2>/dev/null; then
		_json=$_kept_json
		return 1
	fi
	printf '%s' "$(printf '%s' "$_json" | unescape | grep -oE 'https://[^"]*\.m3u8[^"]*' | head -n 1)"
	_json=$_kept_json
}

resolve_episode() {
	_embed=$(provider_embed "$2") || return 1
	[ -z "$_embed" ] && return 1
	refr="https://megaplay.buzz/"
	intro_start=0
	intro_end=0
	outro_start=0
	outro_end=0

	info "Resolving $(ep_display "$2")..."
	load_embed "$_embed" || return 1

	_m3u8=$(printf '%s' "$_json" | unescape | grep -oE 'https://[^"]*\.m3u8[^"]*' | head -n 1)
	[ -z "$_m3u8" ] && _m3u8=$(printf '%s' "$_plain" | grep -oE 'https://[^"]*\.m3u8[^"]*' | head -n 1)
	[ -z "$_m3u8" ] && return 1


	# skip marks: the player hands us the intro and outro ranges
	_intro_obj=$(printf '%s' "$_plain" | grep -oE '"intro":\{[^}]*\}' | head -n 1)
	_outro_obj=$(printf '%s' "$_plain" | grep -oE '"outro":\{[^}]*\}' | head -n 1)
	intro_start=$(printf '%s' "$_intro_obj" | sed -nE 's|.*"start":[[:space:]]*([0-9.]+).*|\1|p')
	intro_end=$(printf '%s' "$_intro_obj" | sed -nE 's|.*"end":[[:space:]]*([0-9.]+).*|\1|p')
	outro_start=$(printf '%s' "$_outro_obj" | sed -nE 's|.*"start":[[:space:]]*([0-9.]+).*|\1|p')
	outro_end=$(printf '%s' "$_outro_obj" | sed -nE 's|.*"end":[[:space:]]*([0-9.]+).*|\1|p')
	for _v in intro_start intro_end outro_start outro_end; do
		eval "[ -z \"\$$_v\" ] && $_v=0"
	done

	# every subtitle track the player offers: code, label, default flag, url
	_tracks=$(printf '%s' "$_plain" | grep -oE '\{[^{}]*"file":"[^"]*\.vtt"[^{}]*\}')
	sub_tracks=$(printf '%s\n' "$_tracks" | while IFS= read -r _obj; do
		[ -z "$_obj" ] && continue
		_url=$(printf '%s' "$_obj" | sed -nE 's|.*"file":"([^"]+)".*|\1|p')
		[ -z "$_url" ] && continue
		_label=$(printf '%s' "$_obj" | sed -nE 's|.*"label":"([^"]*)".*|\1|p')
		_def=0
		case "$_obj" in *'"default":true'*) _def=1 ;; esac
		_code=$(printf '%s' "$_url" | sed -nE 's|.*/([A-Za-z]{2,3})(-[0-9]+)?\.vtt$|\1|p' | tr 'A-Z' 'a-z')
		[ -z "$_code" ] && _code=und
		[ -z "$_label" ] && _label=$_code
		printf '%s\t%s\t%s\t%s\n' "$_code" "$_label" "$_def" "$_url"
	done)

	pick_sub

	if [ "$list_subs" = 1 ]; then
		if [ -z "$sub_tracks" ]; then
			printf 'No subtitles for episode %s\n' "$2"
		else
			printf 'Subtitles for episode %s:\n' "$2"
			printf '%s\n' "$sub_tracks" | awk -F'\t' '{ printf "  %-4s %-44s %s\n", $1, $2, ($3 == 1 ? "(default)" : "") }'
		fi
		exit 0
	fi

	_playlist=$(http_get "$_m3u8" "$refr")

	# a stream can hold both audio languages as renditions of one file, and the
	# original one is what it marks as the default, so a player takes Japanese
	# even from the dubbed url. dub means the English rendition is played
	_audio_group=$(printf '%s' "$_playlist" | grep -c 'EXT-X-MEDIA:TYPE=AUDIO')
	_audio_en=$(printf '%s' "$_playlist" | grep 'EXT-X-MEDIA:TYPE=AUDIO' | grep -c 'LANGUAGE="en')
	if [ "$mode" = dub ]; then
		# a source without a dub still answers the dubbed url, either with a
		# stream that has no English rendition or with the subbed file itself
		if [ "$_audio_group" -gt 0 ]; then
			[ "$_audio_en" -eq 0 ] && return 1
		else
			_sub_embed=$(sub_embed_for "$2")
			if [ -n "$_sub_embed" ]; then
				_sub_file=$(file_of_embed "$_sub_embed")
				[ -n "$_sub_file" ] &&
					[ "$(media_key "$_sub_file")" = "$(media_key "$_m3u8")" ] && return 1
			fi
		fi
	fi
	links=$(printf '%s\n' "$_playlist" |
		sed 's|^#EXT-X-STREAM.*x||g; s|,.*|p|g; /^#/d; $!N; s|\n| >|; /EXT-X-I-FRAME/d' |
		sed "\|>https*://|!s|>|>${_m3u8%/*}/|" | sort -gr -s)
	[ -z "$links" ] && links="direct >$_m3u8"

	stream_flags=""
	if printf '%s' "$_playlist" | grep -q 'EXT-X-MEDIA:TYPE=AUDIO'; then
		# the variants hold picture only and the master names the audio
		# renditions beside them, so playing a variant alone is silent: give the
		# player the master and cap the bandwidth when a quality was asked for
		video_link="$_m3u8"
		case "$quality" in
			worst) _bw=$(printf '%s\n' "$_playlist" | sed -nE 's/.*BANDWIDTH=([0-9]+).*/\1/p' | sort -n | head -n 1) ;;
			best | '') _bw="" ;;
			*)
				_q=${quality%p}
				_bw=$(printf '%s\n' "$_playlist" | grep -F "NAME=\"${_q}p\"" |
					sed -nE 's/.*BANDWIDTH=([0-9]+).*/\1/p' | head -n 1)
				[ -z "$_bw" ] && _bw=$(printf '%s\n' "$_playlist" |
					grep -E "RESOLUTION=[0-9]+x${_q}([^0-9]|$)" |
					sed -nE 's/.*BANDWIDTH=([0-9]+).*/\1/p' | head -n 1)
				;;
		esac
		[ -n "$_bw" ] && stream_flags="--hls-bitrate=$_bw"
	else
		select_quality "$quality"
	fi
	[ -z "$video_link" ] && return 1
	info "Stream ready"
}

# resolve_episode_any <ep>: resolve_episode, but when the source it picked has no
# stream for that episode the same show is looked up on the other one, so a title
# that only one of them really carries still plays
resolve_episode_any() {
	_ep=$1
	resolve_episode "$anime_id" "$_ep" && return 0

	_saved_provider=$provider
	_saved_id=$anime_id
	_saved_maps=$episode_maps

	for _p in animesuge anichan; do
		[ "$_p" = "$_saved_provider" ] && continue
		_base=$(season_base "$anime_title")
		# the title as it is written, and then without its spacing: a source that
		# has nothing for "dan da dan" still finds "dandadan"
		_flat=$(printf '%s' "$_base" | LC_ALL=C tr -d '[:punct:] ' | LC_ALL=C tr 'A-Z' 'a-z')
		_row=""
		for _q in "$(season_query "$_base")" "$_flat"; do
			[ -z "$_q" ] && continue
			# asked straight from the source: in the merged list a title that both
			# of them carry is kept once, and the copy that is left can belong to
			# the source that just failed
			case "$_p" in
				animesuge) _rows=$(as_search_all "$_q" 2>/dev/null | cut -f 1,2) ;;
				anichan) _rows=$(ac_search "$_q" 2>/dev/null | cut -f 1,2) ;;
				esac
			# every row is checked, not just the first: the opening row for a
			# query is often a different show altogether
			_row=$(printf '%s\n' "$_rows" |
				while IFS="$TAB" read -r _rid _rlabel; do
					[ -z "$_rid" ] && continue
					same_series "$anime_title" "$_rlabel" || continue
					[ "$(season_no "$anime_title")" = "$(season_no "$_rlabel")" ] || continue
					printf '%s\t%s\n' "$_rid" "$_rlabel"
					break
				done)
			[ -n "$_row" ] && break
		done
		[ -z "$_row" ] && continue
		_id=$(printf '%s' "$_row" | cut -f 1)
		[ "$_p" = animesuge ] && _id=$(as_anime_id "$_id")
		[ -z "$_id" ] && continue

		provider=$_p
		anime_id=$_id
		episode_maps=$(provider_episode_maps "$_id")
		if [ -n "$episode_maps" ]; then
			resolve_episode "$anime_id" "$_ep" && return 0
		fi
		provider=$_saved_provider
		anime_id=$_saved_id
		episode_maps=$_saved_maps
	done
	return 1
}

# ---------------------------------------------------------------------------
# nime-skip: skips the ranges the player reports, through a generated mpv script
# ---------------------------------------------------------------------------

cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/_nime"
skip_lua="$cache_dir/nime-skip.lua"
year_cache="$cache_dir/years"
mkdir -p "$cache_dir" 2>/dev/null
[ -f "$year_cache" ] || : >"$year_cache" 2>/dev/null

write_skip_script() {
	mkdir -p "$cache_dir" 2>/dev/null || return 1
	cat >"$skip_lua" <<-'LUA'
	-- nime-skip: skip the opening and ending ranges reported by the player
	local mp = require 'mp'
	local opts = require 'mp.options'
	local o = { intro_start = 0, intro_end = 0, outro_start = 0, outro_end = 0, padding = 1.5 }
	opts.read_options(o, 'nime_skip')
	local done_intro, done_outro = false, false

	local function skip(target, label)
		mp.commandv('seek', tostring(target), 'absolute')
		mp.osd_message(label, 2)
	end

	mp.observe_property('time-pos', 'number', function(_, pos)
		if not pos then return end
		if not done_intro and o.intro_start > 0 and o.intro_end > o.intro_start then
			if pos >= o.intro_start - 0.5 and pos < o.intro_end - o.padding then
				done_intro = true
				skip(o.intro_end, 'nime-skip: intro')
			end
		end
		if not done_outro and o.outro_start > 0 and o.outro_end > o.outro_start then
			if pos >= o.outro_start - 0.5 and pos < o.outro_end - o.padding then
				done_outro = true
				skip(o.outro_end, 'nime-skip: outro')
			end
		end
	end)
	LUA
	[ -s "$skip_lua" ]
}

build_skip_flag() {
	skip_flag=""
	[ "$skip_intro" = 1 ] || return 0
	case "$player_function" in
		*mpv* | *iina* | *yncpla*) ;;
		*)
			warn "--skip needs mpv, ignoring it for this player"
			return 0
			;;
	esac
	_has_marks=$(awk -v a="${intro_start:-0}" -v b="${intro_end:-0}" \
		-v c="${outro_start:-0}" -v d="${outro_end:-0}" \
		'BEGIN { print ((b > a) || (d > c)) ? 1 : 0 }')
	if [ "$_has_marks" != 1 ]; then
		warn "No intro or outro marks for this episode, skipping disabled"
		return 0
	fi
	if ! write_skip_script; then
		warn "Could not write $skip_lua, skipping disabled"
		return 0
	fi
	skip_flag="--script=$skip_lua --script-opts=nime_skip-intro_start=$intro_start,nime_skip-intro_end=$intro_end,nime_skip-outro_start=$outro_start,nime_skip-outro_end=$outro_end"
}

# ---------------------------------------------------------------------------
# history
# ---------------------------------------------------------------------------

hist_dir="${_NIME_HIST_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/_nime}"
mkdir -p "$hist_dir" 2>/dev/null
histfile="$hist_dir/nime-hsts"
[ -f "$histfile" ] || : >"$histfile"

update_history() {
	[ -z "$anime_id" ] && return
	[ -z "$ep_no" ] && return
	_esc_title=$(printf '%s' "$anime_title" | sed 's|\\|\\\\|g; s|&|\\&|g')
	awk -F'\t' -v p="$provider" -v id="$anime_id" -v ep="$ep_no" -v t="$_esc_title" '
		BEGIN { OFS="\t"; found=0 }
		$2==p && $3==id { print ep, p, id, t; found=1; next }
		{ print }
		END { if (!found) print ep, p, id, t }
	' "$histfile" >"${histfile}.new" && mv "${histfile}.new" "$histfile"
}

# ---------------------------------------------------------------------------
# playback
# ---------------------------------------------------------------------------

# the downloads folder itself: the one the desktop uses, so nothing has to be
# picked, and made there when it is not there yet, because an episode saved in
# the home directory is one you have to go looking for. the order is the XDG
# download dir, Downloads, Desktop, home; _NIME_DOWNLOAD_DIR overrides it all.
# the files go into a _nime downloads folder inside it, one folder per series.
download_dir() {
	if [ -n "$_NIME_DOWNLOAD_DIR" ]; then
		mkdir -p "$_NIME_DOWNLOAD_DIR" 2>/dev/null
		printf '%s' "$_NIME_DOWNLOAD_DIR"
		return
	fi

	# on Android the phone already has a shared Download folder, and that is the
	# one the file manager and the gallery list
	_base=""
	if [ "$os_id" = android ] && [ -d /storage/emulated/0 ]; then
		_base=/storage/emulated/0/Download
	fi

	if [ -z "$_base" ] && [ -f "${XDG_CONFIG_HOME:-$HOME/.config}/user-dirs.dirs" ]; then
		_base=$(sed -n 's|^XDG_DOWNLOAD_DIR="\(.*\)"$|\1|p' \
			"${XDG_CONFIG_HOME:-$HOME/.config}/user-dirs.dirs" | head -n 1)
		_base=$(printf '%s' "$_base" | sed "s|^\$HOME|$HOME|")
	fi

	# the first one that is already there or can be created, so a device without
	# ~/Downloads gets one instead of a download in the home directory
	for _c in "$_base" "$HOME/Downloads" "$HOME/Download" "$HOME/Desktop" "$HOME/desktop" "$HOME"; do
		[ -n "$_c" ] || continue
		mkdir -p "$_c" 2>/dev/null || continue
		[ -w "$_c" ] || continue
		printf '%s' "$_c"
		return
	
done

	printf '%s' "$HOME"
}

# one updating line from a yt-dlp progress line: [#####     ]  42.3% 1.2MiB/s
# it writes to stderr with a carriage return, so the rest of the output stays put
draw_progress() {
	_pct=$(printf '%s' "$1" | sed -nE 's/.*\[download\][[:space:]]+([0-9.]+)%.*/\1/p' | head -n 1)
	[ -z "$_pct" ] && return 1
	_speed=$(printf '%s' "$1" | sed -nE 's#.*[[:space:]]([0-9.]+[KMG]?iB/s).*#\1#p' | head -n 1)
	_eta=$(printf '%s' "$1" | sed -nE 's#.*ETA[[:space:]]+([0-9:]+).*#ETA \1#p' | head -n 1)
	_done=$(awk -v p="$_pct" 'BEGIN { d = int(p / 5); print (d > 20 ? 20 : d) }')
	_bar=$(awk -v d="$_done" 'BEGIN {
		s = ""
		for (i = 0; i < 20; i++) s = s (i < d ? "#" : "-")
		printf "%s", s
	}')
	awk -v b="$_bar" -v p="$_pct" -v s="$_speed" -v e="$_eta" 'BEGIN {
		printf "\r\033[2K  %s %6s%%  %-10s %s", b, p, s, e
	}' >&2
}

# downloads are written as mp4 with the subtitles muxed in as a soft
# (selectable) track, which mpv, vlc, quicktime and every normal player lists
# in its subtitle menu.
download_video() {
	# one folder per series inside _nime downloads, so a binge does not mix with
	# the rest of the downloads folder
	_base=$(download_dir)
	_show=$(printf '%s' "$anime_title" | sed 's|[/\\:*?"<>|]|_|g; s|  *| |g; s|^ *||; s| *$||')
	[ -z "$_show" ] && _show=_nime
	_dl_dir="$_base/_nime downloads/$_show"
	if ! mkdir -p "$_dl_dir" 2>/dev/null; then
		warn "Could not create $_dl_dir, using the current directory"
		_dl_dir=$(pwd)
	fi

	_name="E${ep_no}"
	_tmpd=$(mktemp -d 2>/dev/null)
	[ -d "$_tmpd" ] || {
		_tmpd="$_dl_dir/.nime-tmp-$$"
		mkdir -p "$_tmpd"
	}
	_final="$_dl_dir/$_name.mp4"

	info "Downloading $anime_title episode $ep_no..."
	# the audio has to be picked by language: the master carries English and
	# Japanese, its default is Japanese, so a dub would quietly download the
	# subbed audio. yt-dlp has no --alang (that is mpv's), hence the format chain
	case "$mode" in
		dub) _want=en ;;
		*) _want=ja ;;
	esac
	_fmt="bv*+ba[language=$_want]/bv*+ba[language^=$_want]/bv*+ba/b"
	_ok=0
	if command -v yt-dlp >/dev/null 2>&1; then
		# the progress lines become one bar, everything else goes to a log so a
		# failure can say what actually went wrong
		# the stream is a list of small fragments and yt-dlp fetches them one at a
		# time by default, which leaves the line idle: a few at once is most of
		# the speed. Servers throttle that though, so a download that runs into
		# "too many requests" is tried again on one connection, which always works
		for _n in 4 1; do
			(
				yt-dlp --newline --progress --referer "$refr" -f "$_fmt" --merge-output-format mp4 \
					-N "$_n" --fragment-retries 15 --retries 10 --retry-sleep fragment:exp=1:30 \
					-o "$_tmpd/raw.%(ext)s" "$video_link" 2>&1
				printf 'rc=%s\n' "$?" >"$_tmpd/rc"
			) | while IFS= read -r _line; do
				printf '%s\n' "$_line" >>"$_tmpd/ytdl.log"
				draw_progress "$_line" || :
			done
			printf '\r\033[2K' >&2
			_rc=$(sed -n 's/^rc=//p' "$_tmpd/rc" 2>/dev/null)
			[ "$_rc" = 0 ] && { _ok=1; break; }
			# only a throttled server is worth a slower second try
			grep -q '429\|Too Many Requests' "$_tmpd/ytdl.log" 2>/dev/null || break
			info "Server is limiting requests, continuing on a single connection..."
		done
	elif command -v ffmpeg >/dev/null 2>&1; then
		# ffmpeg takes the stream's default audio, which is the original one, so
		# the language is named here before falling back to whatever there is
		if ffmpeg -loglevel error -y -referer "$refr" -i "$video_link" \
			-map 0:v:0 -map "0:a:m:language:$_want" \
			-c copy -bsf:a aac_adtstoasc "$_tmpd/raw.mp4" 2>/dev/null; then
			_ok=1
		elif ffmpeg -loglevel error -y -referer "$refr" -i "$video_link" \
			-c copy -bsf:a aac_adtstoasc "$_tmpd/raw.mp4"; then
			_ok=1
		fi
	else
		warn "Neither yt-dlp nor ffmpeg found, cannot download"
		rm -rf "$_tmpd"
		return 1
	fi

	if [ "$_ok" != 1 ]; then
		warn "Download failed"
		# say why, instead of leaving nothing but "failed"
		_why=$(grep -E '^ERROR|error:|HTTP Error|Unsupported|Unable' "$_tmpd/ytdl.log" 2>/dev/null | tail -n 2)
		[ -z "$_why" ] && _why=$(tail -n 3 "$_tmpd/ytdl.log" 2>/dev/null)
		[ -n "$_why" ] && printf '%s\n' "$_why" >&2
		rm -rf "$_tmpd"
		return 1
	fi

	_raw=$(ls "$_tmpd"/raw.* 2>/dev/null | head -n 1)
	[ -z "$_raw" ] && {
		warn "Download produced no file"
		rm -rf "$_tmpd"
		return 1
	}

	# which tracks to embed: everything with --sub-lang all, otherwise the pick
	_sel_tracks=""
	if [ "$subs_on" = 1 ] && [ -n "$sub_tracks" ]; then
		case "$sub_lang" in
			all | ALL | All) _sel_tracks=$sub_tracks ;;
			*)
				if [ -n "$sub_link" ]; then
					_sel_tracks=$(printf '%s\n' "$sub_tracks" | awk -F'\t' -v u="$sub_link" '$4 == u { print; exit }')
					[ -z "$_sel_tracks" ] && _sel_tracks=$(printf '%s\n' "$sub_tracks" |
						awk -F'\t' -v c="$sub_code" '$1 == c { print; exit }')
				fi
				;;
		esac
	fi

	mkdir -p "$_tmpd/subs"
	_k=0
	if [ -n "$_sel_tracks" ]; then
		printf '%s\n' "$_sel_tracks" >"$_tmpd/tracks.tsv"
		_k=0
		while IFS=$TAB read -r _code _label _def _url; do
			[ -z "$_url" ] && continue
			_n=$(printf '%02d' $((_k + 1)))
			curl -sSL -A "$agent" -e "$refr" --max-time 60 \
				-o "$_tmpd/subs/sub-$_n.vtt" "$_url" 2>/dev/null
			if [ -s "$_tmpd/subs/sub-$_n.vtt" ]; then
				_k=$((_k + 1))
				printf '%s\t%s\n' "$_n" "$_code" >>"$_tmpd/subs/index.tsv"
			else
				rm -f "$_tmpd/subs/sub-$_n.vtt"
			fi
		done <"$_tmpd/tracks.tsv"
	fi

	_subs=0
	if [ "$_k" -gt 0 ] && command -v ffmpeg >/dev/null 2>&1; then
		_inputs=""
		_maps="-map 0:v:0 -map 0:a?"
		_meta=""
		_disp=""
		_j=0
		while IFS=$TAB read -r _n _code; do
			_inputs="$_inputs -i $_tmpd/subs/sub-$_n.vtt"
			_maps="$_maps -map $((_j + 1)):0"
			_meta="$_meta -metadata:s:s:$_j language=$_code"
			[ "$_code" = "$sub_code" ] && _disp="-disposition:s:s:$_j default"
			_j=$((_j + 1))
		done <"$_tmpd/subs/index.tsv"
		[ -z "$_disp" ] && _disp="-disposition:s:s:0 default"

		info "Muxing $_j subtitle track(s) into the video..."
		# word splitting is wanted here: the flags are built up above
		if ffmpeg -loglevel error -y -i "$_raw" $_inputs $_maps \
			-c copy -c:s mov_text $_meta $_disp "$_final"; then
			_subs=1
		else
			warn "Could not mux the subtitles, saving them next to the video instead"
		fi
	fi

	if [ "$_subs" = 1 ]; then
		rm -rf "$_tmpd"
		info "Saved $_final ($_j subtitle track(s), switch them in your player)"
		return 0
	fi

	if [ -f "$_tmpd/subs/index.tsv" ]; then
		while IFS=$TAB read -r _n _code; do
			cp "$_tmpd/subs/sub-$_n.vtt" "$_dl_dir/$_name.$_code.vtt" 2>/dev/null
		done <"$_tmpd/subs/index.tsv"
	fi
	mv "$_raw" "$_final" 2>/dev/null || cp "$_raw" "$_final"
	_rc=$?
	rm -rf "$_tmpd"
	[ "$_rc" = 0 ] && info "Saved $_final"
	return $_rc
}

need_am() {
	command -v am >/dev/null 2>&1 && return 0
	warn "'am' not found, Android cannot be handed the stream."
	warn "Inside Termux install it with: pkg install termux-am"
	return 1
}

# mpv-android takes no options from the intent, so they go through a file
# that the user includes in mpv.conf
# android_app is.xyz.mpv -> the app is installed, so an intent for it will land
android_app() {
	# /system/bin is not on the path inside Termux, so pm is looked for there when
	# it is not found by name; without that every check said the app was missing
	_pm=$(command -v pm 2>/dev/null) || _pm=/system/bin/pm
	[ -x "$_pm" ] || return 1
	"$_pm" list packages 2>/dev/null | grep -q "^package:$1$"
}

# android_store -> the Google Play page for VLC is open
# every step names com.android.vending, so an alternative store that answers the
# market:// link cannot take it instead
android_store() {
	for _s in "market://details?id=org.videolan.vlc" \
		"https://play.google.com/store/apps/details?id=org.videolan.vlc"; do
		_out=$(am start --user 0 -a android.intent.action.VIEW -d "$_s" \
			-p com.android.vending 2>&1)
		case "$_out" in
			*"Error"* | *"Exception"* | *"not found"*) continue ;;
		esac
		return 0
	done
	# no Play Store on the device: the page in a browser, so it can still be got
	_out=$(am start --user 0 -a android.intent.action.VIEW \
		-d "https://play.google.com/store/apps/details?id=org.videolan.vlc" 2>&1)
	case "$_out" in
		*"Error"* | *"Exception"* | *"not found"*) return 1 ;;
	esac
	return 0
}

# the streams answer 403 without the site's referrer, and the player app accepts no
# headers through an intent, so the app is given a local address that sends them
# for it: a small proxy in this session fetches the playlist and every segment
# with the referrer, and VLC just plays what it is handed
android_proxy_start() {
	command -v python3 >/dev/null 2>&1 || return 1
	_s="${TMPDIR:-/tmp}/_nime-proxy.py"
	cat >"$_s" <<'PY'
import base64, os, re, sys, socketserver, urllib.parse, urllib.request
from http.server import BaseHTTPRequestHandler

REF = sys.argv[1] if len(sys.argv) > 1 else ""
UA = sys.argv[2] if len(sys.argv) > 2 else ""
PORT = int(sys.argv[3]) if len(sys.argv) > 3 else 8770


def enc(url):
    return base64.urlsafe_b64encode(url.encode()).decode().rstrip("=")


def dec(payload):
    try:
        return base64.urlsafe_b64decode(payload + "=" * (-len(payload) % 4)).decode()
    except Exception:
        return ""


def proxied(base, ref):
    target = urllib.parse.urljoin(base, ref)
    ext = os.path.splitext(urllib.parse.urlparse(target).path)[1] or ".bin"
    return "/p/x" + ext + "?u=" + enc(target)


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, *args):
        pass

    def target(self):
        query = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
        return dec(query.get("u", [""])[0])

    def lang(self):
        query = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
        return (query.get("l", [""])[0] or "")[:2].lower()

    def handle_one(self):
        if self.path == "/health":
            body = b"ok"
            self.send_response(200)
            self.send_header("Content-Type", "text/plain")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
            return
        url = self.target()
        if not url:
            self.send_error(404)
            return
        request = urllib.request.Request(
            url, headers={"User-Agent": UA or "Mozilla/5.0", "Referer": REF})
        try:
            upstream = urllib.request.urlopen(request, timeout=30)
            data = upstream.read()
        except Exception:
            self.send_error(502)
            return
        ctype = (upstream.headers.get("Content-Type") or "").lower()
        if "mpegurl" in ctype or data[:7] == b"#EXTM3U":
            text = data.decode("utf-8", "replace")
            # a stream can carry every audio language and mark the original as
            # the default, which is what a player then plays; only the one this
            # run asked for is kept, and it is made the default
            want = self.lang()
            if want and "#EXT-X-MEDIA" in text:
                kept = None
                rest = []
                for line in text.splitlines():
                    if "#EXT-X-MEDIA" in line and "TYPE=AUDIO" in line:
                        if kept is None and re.search(r'LANGUAGE="%s' % want, line, re.I):
                            kept = line
                        continue
                    rest.append(line)
                if kept is not None:
                    kept = re.sub(r"DEFAULT=NO", "DEFAULT=YES", kept)
                    kept = re.sub(r"AUTOSELECT=NO", "AUTOSELECT=YES", kept)
                    rest.insert(1 if rest and rest[0].strip() == "#EXTM3U" else 0, kept)
                    text = "\n".join(rest)
            lines = []
            for line in text.splitlines():
                stripped = line.strip()
                if not stripped:
                    lines.append(line)
                elif stripped.startswith("#"):
                    # keys and other URIs live inside tag lines
                    lines.append(re.sub(
                        r'URI="([^"]+)"',
                        lambda m: 'URI="%s"' % proxied(url, m.group(1)), line))
                else:
                    lines.append(proxied(url, stripped))
            body = ("\n".join(lines) + "\n").encode()
            self.send_response(200)
            self.send_header("Content-Type", "application/vnd.apple.mpegurl")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
            return
        # the cdn answers segments with whatever it likes, image/jpeg included,
        # so the type comes from the name this proxy gave the piece instead
        suffix = os.path.splitext(urllib.parse.urlparse(self.path).path)[1].lower()
        types = {".ts": "video/mp2t", ".m4s": "video/iso.segment",
                 ".mp4": "video/mp4", ".aac": "audio/aac",
                 ".vtt": "text/vtt", ".key": "application/octet-stream"}
        self.send_response(200)
        self.send_header("Content-Type", types.get(suffix, "application/octet-stream"))
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    do_GET = handle_one
    do_HEAD = handle_one


socketserver.TCPServer.allow_reuse_address = True
with socketserver.ThreadingTCPServer(("127.0.0.1", PORT), Handler) as server:
    server.serve_forever()
PY
	[ -s "$_s" ] || return 1
	# the proxy has to outlive the terminal while the player is in front
	command -v termux-wake-lock >/dev/null 2>&1 && termux-wake-lock >/dev/null 2>&1
	_portfile="${TMPDIR:-/tmp}/_nime-proxy.port"
	if [ -f "$_portfile" ]; then
		_p=$(cat "$_portfile" 2>/dev/null)
		if [ -n "$_p" ] && curl -fsS --max-time 2 "http://127.0.0.1:$_p/health" >/dev/null 2>&1; then
			printf '%s' "$_p"
			return 0
		fi
	fi
	for _p in 8770 8771 8772 8773 8774 8775; do
		python3 "$_s" "$refr" "$agent" "$_p" >/dev/null 2>&1 &
		_i=0
		while [ "$_i" -lt 15 ]; do
			sleep 0.2
			if curl -fsS --max-time 1 "http://127.0.0.1:$_p/health" >/dev/null 2>&1; then
				printf '%s' "$_p" >"$_portfile"
				printf '%s' "$_p"
				return 0
			fi
			_i=$((_i + 1))
		done
	done
	return 1
}

android_watch_url() {
	_p=$(android_proxy_start) || return 1
	_enc=$(printf '%s' "$video_link" | openssl base64 -A | tr '+/' '-_' | tr -d '=')
	[ -n "$_enc" ] || return 1
	_watch_url="http://127.0.0.1:$_p/p/x.m3u8?u=$_enc&l=${audio_lang_short:-en}"
}

# android_vlc_playlist -> a playlist holding the stream and the referrer
# the streams answer 403 to a request without the referrer, and the VLC app takes
# no headers through an intent; a playlist it reads does carry them, so that is
# what it is given
android_vlc_playlist() {
	# only a folder the player app can read will do: Termux's own home is not one
	for _dir in "${_NIME_SHARED_DIR:-}" /storage/emulated/0/Download /storage/emulated/0; do
		[ -n "$_dir" ] && [ -d "$_dir" ] && [ -w "$_dir" ] && break
		_dir=""
	done
	[ -n "$_dir" ] || return 1
	_pl="$_dir/_nime.m3u"
	{
		printf '#EXTM3U\n'
		printf '#EXTVLCOPT:http-referrer=%s\n' "$refr"
		printf '#EXTVLCOPT:http-user-agent=%s\n' "$agent"
		[ -n "$sub_link" ] && printf '#EXTVLCOPT:sub-file=%s\n' "$sub_link"
		printf '%s\n' "$video_link"
	} >"$_pl" 2>/dev/null || return 1
	[ -s "$_pl" ] || return 1
	printf '%s' "$_pl"
}

# android_play_vlc -> VLC has the episode
# the app is asked to open it rather than looked up in a list: that is the same
# question, and it cannot be answered wrong by a missing pm
android_play_vlc() {
	# the proxy is the one that works: it sends the headers the app cannot
	if android_watch_url; then
		_out=$(am start --user 0 -a android.intent.action.VIEW -d "$_watch_url" \
			-n org.videolan.vlc/org.videolan.vlc.gui.video.VideoPlayerActivity \
			-e "title" "$anime_title $ep_label" 2>&1)
		case "$_out" in
			*"Error"* | *"Exception"* | *"not found"*) : ;;
			*) return 0 ;;
		esac
	fi
	_pl=$(android_vlc_playlist) && [ -n "$_pl" ] && {
		_out=$(am start --user 0 -a android.intent.action.VIEW -d "file://$_pl" \
			-n org.videolan.vlc/org.videolan.vlc.gui.video.VideoPlayerActivity \
			-e "title" "$anime_title $ep_label" 2>&1)
		case "$_out" in
			*"Error"* | *"Exception"* | *"not found"*) : ;;
			*) return 0 ;;
		esac
	}
	# no shared folder to write the playlist into: the bare link still opens, and
	# the player is the one that will refuse it if the stream insists on headers
	_out=$(am start --user 0 -a android.intent.action.VIEW -d "$video_link" \
		-n org.videolan.vlc/org.videolan.vlc.gui.video.VideoPlayerActivity \
		-e "title" "$anime_title $ep_label" 2>&1)
	case "$_out" in
		*"Error"* | *"Exception"* | *"not found"*) return 1 ;;
	esac
	warn "Storage is not set up, so the referrer the stream needs could not be sent"
	warn "Run termux-setup-storage once and try again"
	return 0
}

android_mpv() {
	if ! command -v am >/dev/null 2>&1; then
		warn "This phone has no am command, so nothing can be handed to a player"
		warn "On Termux: pkg install termux-am"
		printf '\n%s\n' "$video_link"
		return 1
	fi
	# VLC gets the episode straight away when it is installed; only a failure to
	# open it counts as missing
	if android_play_vlc; then
		return 0
	fi
	warn "VLC is what plays these streams, and it did not open"
	if android_store; then
		warn "Install it from the Play Store, then run: _nime -c -S 1"
	else
		warn "Get it from https://www.videolan.org/vlc/download-android.html"
		warn "then run: _nime -c -S 1"
	fi
	return 1
}

play_episode() {
	ep_label=$(ep_display "$ep_no")

	# mpv takes the next episode in the window it already has open
	case "$player_function" in
		*mpv*) player_ipc_setup ;;
	esac

	if [ "$player_running" = 1 ] && [ "$player_ipc" = 1 ] && [ -n "$player_sock" ]; then
		player_cmd "{\"command\":[\"set_property\",\"alang\",\"$audio_lang\"]}"
		# the title has to be set through the option, before the load: media-title
		# is read only, so setting it afterwards did nothing and the window kept
		# the title of the first episode while playing a different one
		player_cmd "{\"command\":[\"set_property\",\"options/force-media-title\",\"$(json_escape "$anime_title $ep_label")\"]}"
		player_cmd "{\"command\":[\"loadfile\",\"$(json_escape "$video_link")\",\"replace\"]}"
		[ -n "$sub_link" ] && player_cmd "{\"command\":[\"sub-add\",\"$(json_escape "$sub_link")\",\"select\"]}"
		clear_status
		replay="$video_link"
		unset video_link
		update_history
		return
	fi

	# only hand the player a socket when there is a client that can talk to it
	_ipc_flag=""
	[ "$player_ipc" = 1 ] && [ -n "$player_sock" ] && _ipc_flag="--input-ipc-server=$player_sock"

	if [ "$player_function" = download ]; then
		download_video
		unset video_link
		return
	fi

	build_skip_flag

	case "$player_function" in
		print)
			print_stream
			unset video_link
			update_history
			return
			;;
		android_mpv)
			if need_am; then
				android_mpv
			fi
			;;
		android_vlc)
			if need_am; then
				nohup am start --user 0 -a android.intent.action.VIEW -d "$video_link" \
					-n org.videolan.vlc/org.videolan.vlc.gui.video.VideoPlayerActivity \
					-e "title" "$anime_title $ep_label" $player_extra_flags >/dev/null 2>&1 &
			fi
			;;
		*flatpak*mpv*)
			nohup flatpak run io.mpv.Mpv --input-ipc-server="$player_sock" --referrer="$refr" --alang="$audio_lang" ${sub_link:+--sub-file="$sub_link"} \
				$skip_flag $stream_flags $player_extra_flags --force-media-title="$anime_title $ep_label" \
				"$video_link" >/dev/null 2>&1 &
			;;
		*iina*)
			_sub_iina=$(printf '%s' "$sub_link" | sed 's|:|\\:|g')
			if pgrep -f "IINA" >/dev/null 2>&1; then
				nohup $player_function --mpv-referrer="$refr" --mpv-alang="$audio_lang" ${_sub_iina:+--mpv-sub-files="$_sub_iina"} \
					$skip_flag $player_extra_flags --no-stdin \
					--mpv-force-media-title="$anime_title $ep_label" "$video_link" >/dev/null 2>&1 &
			else
				nohup $player_function --mpv-referrer="$refr" --mpv-alang="$audio_lang" ${_sub_iina:+--mpv-sub-files="$_sub_iina"} \
					$skip_flag $player_extra_flags --no-stdin --keep-running \
					--mpv-force-media-title="$anime_title $ep_label" "$video_link" >/dev/null 2>&1 &
			fi
			;;
		*yncpla*)
			nohup $player_function $player_extra_flags "$video_link" -- $skip_flag --referrer="$refr" \
				${sub_link:+--sub-file="$sub_link"} \
				--force-media-title="$anime_title $ep_label" >/dev/null 2>&1 &
			;;
		*mpv*)
			if [ "$no_detach" = 1 ]; then
				$player_function $_ipc_flag --referrer="$refr" --alang="$audio_lang" ${sub_link:+--sub-file="$sub_link"} \
					$skip_flag $stream_flags $player_extra_flags --force-media-title="$anime_title $ep_label" "$video_link"
			else
				nohup $player_function $_ipc_flag --referrer="$refr" --alang="$audio_lang" ${sub_link:+--sub-file="$sub_link"} \
					$skip_flag $stream_flags $player_extra_flags --force-media-title="$anime_title $ep_label" \
					"$video_link" >/dev/null 2>&1 &
			fi
			;;
		*vlc*)
			if [ "$no_detach" = 1 ]; then
				$player_function --http-referrer="$refr" $player_extra_flags --play-and-exit \
					--meta-title="$anime_title $ep_label" --audio-language="$audio_lang_short" "$video_link" \
					:input-slave="${sub_link:-}"
			else
				nohup $player_function --http-referrer="$refr" $player_extra_flags --play-and-exit \
					--meta-title="$anime_title $ep_label" --audio-language="$audio_lang_short" "$video_link" \
					:input-slave="${sub_link:-}" >/dev/null 2>&1 &
			fi
			;;
		iSH)
			# iOS cannot be asked from a shell whether VLC is installed, so VLC is
			# simply asked to open the stream; when it does not, both taps are
			# printed: the App Store for VLC and the link to play
			if command -v open >/dev/null 2>&1 && open "vlc://$video_link" >/dev/null 2>&1; then
				info "Opening VLC"
			else
				printf '\033]8;;vlc://%s\a~~~~~~~~~~~~~~~\n~ Tap to play ~\n~~~~~~~~~~~~~~~\033]8;;\a\n' "$video_link"
				printf '\033]8;;https://apps.apple.com/app/vlc-for-mobile/id650377962\a~~~ No VLC? Tap for it in the App Store ~~~\033]8;;\a\n'
			fi
			sleep 5
			;;
		*)
			if [ "$no_detach" = 1 ]; then
				$player_function $player_extra_flags "$video_link"
			else
				nohup $player_function $player_extra_flags "$video_link" >/dev/null 2>&1 &
			fi
			;;
	esac

	# wait for the control socket, then remember that a window is open
	if [ "$player_ipc" = 1 ] && [ -n "$player_sock" ]; then
		_i=0
		while [ "$_i" -lt 30 ] && [ ! -S "$player_sock" ]; do
			sleep 0.1
			_i=$((_i + 1))
		done
		[ -S "$player_sock" ] && player_running=1
	fi

	# the player has the stream now, so the progress lines have done their job.
	# iSH is the exception: its branch prints a link the user has to tap
	[ "$player_function" = iSH ] || clear_status

	replay="$video_link"
	unset video_link
	update_history
}

play() {
	_spec=$1
	[ -z "$_spec" ] && die "No episode selected"
	_range=""

	case "$_spec" in
		*" "*)
			_first=$(printf '%s' "$_spec" | awk '{print $1}')
			_last=$(printf '%s' "$_spec" | awk '{print $NF}')
			_range=$(printf '%s\n' "$ep_list" | sed -n "/^${_first}$/,/^${_last}$/p")
			;;
		*-*)
			_first=${_spec%%-*}
			_last=${_spec##*-}
			_range=$(printf '%s\n' "$ep_list" | sed -n "/^${_first}$/,/^${_last}$/p")
			;;
	esac

	if [ -n "$_range" ]; then
		for _i in $_range; do
			ep_no=$_i
			info "Playing $(ep_display "$ep_no"), $(mode_word)..."
			resolve_episode_any "$ep_no" || dub_die "No sources found for episode $ep_no"
			play_episode
		done
		return
	fi

	printf '%s\n' "$ep_list" | grep -qx "$_spec" || die "Invalid episode!"
	ep_no=$_spec
	info "Playing $(ep_display "$ep_no"), $(mode_word)..."
	resolve_episode_any "$ep_no" || dub_die "No sources found for episode $ep_no"
	play_episode
}

# ---------------------------------------------------------------------------
# self update: pull the script back down from the git repository
# ---------------------------------------------------------------------------

update_script() {
	case "$update_base" in
		'' | *CHANGE_ME*) die "Set repo_user at the top of this script (or _NIME_USER=you) before using -U" ;;
	esac
	info "[$repo_branch] Checking for updates..."
	# the contents api is authoritative and never stale; the raw host sits
	# behind a cdn that can serve the previous version for a few minutes
	_latest=$(curl -sSL --max-time 25 -H "Accept: application/vnd.github.raw" \
		"$api_base/_nime?ref=$repo_branch" 2>/dev/null)
	case "$_latest" in
		*'version="'*) ;;
		*)
			_latest=$(curl -sSL --max-time 25 "$update_base/_nime" 2>/dev/null)
			;;
	esac
	[ -z "$_latest" ] && die "[$repo_branch] Connection error"
	_new_version=$(printf '%s' "$_latest" | sed -nE 's|^version="([^"]+)"$|\1|p' | head -n 1)
	[ -z "$_new_version" ] && die "[$repo_branch] Invalid response"

	if [ "$_new_version" = "$version" ]; then
		info "[$repo_branch] Script is up to date ($version)"
		exit 0
	fi

	_self=$(command -v _nime 2>/dev/null || printf '%s' "$0")
	cp "$_self" "${_self}.bak" 2>/dev/null
	if printf '%s' "$_latest" >"${_self}.new" && chmod +x "${_self}.new" && mv "${_self}.new" "$_self"; then
		info "[$repo_branch] Updated: $version -> $_new_version (old copy in ${_self}.bak)"
	else
		rm -f "${_self}.new"
		die "Could not write $_self, try again with sudo"
	fi
	exit 0
}

# load the episode list for $anime_id into $episode_maps / $ep_list,
# stepping down to subs when a show simply has no dub
load_episode_maps() {
	info "Loading episodes..."
	episode_maps=$(provider_episode_maps "$anime_id")
	if [ -z "$episode_maps" ] && [ "$mode" = dub ]; then
		if find_dub_source; then
			episode_maps=$(provider_episode_maps "$anime_id")
		fi
	fi
	# a dub was asked for, so a dub is what is played: quietly switching to the
	# original audio left people hearing Japanese after asking for English
	if [ -z "$episode_maps" ] && [ "$mode" = dub ]; then
		die "No English dub for $anime_title on either source (--sub plays the original audio)"
	fi
	# the site keeps each season as its own entry, so pull them together and
	# keep every episode of every season in one list
	season_total=1
	merge_season_maps || true
	ep_list=$(printf '%s\n' "$episode_maps" | cut -f 1)
	[ -n "$ep_list" ] || return 1
	if [ "$season_total" -gt 1 ]; then
		info "$season_total seasons, $(printf '%s\n' "$ep_list" | grep -c .) episodes"
	fi
}

