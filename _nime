hist_dir="${_NIME_HIST_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/_nime}"
mkdir -p "$hist_dir" 2>/dev/null
histfile="$hist_dir/nime-hsts"
[ -f "$histfile" ] || : >"$histfile"

update_history() {
	[ -z "$anime_id" ] && return
	[ -z "$ep_no" ] && return
	_esc_title=$(printf '%s' "$anime_title" | sed 's|\\|\\\\|g; s|&|\\&|g')
	awk -F'\t' -v p="$provider" -v id="$anime_id" -v ep="$ep_no" -v t="$_esc_title" '
		BEGIN { OFS="\t"; found=0 }
		$2==p && $3==id { print ep, p, id, t; found=1; next }
		{ print }
		END { if (!found) print ep, p, id, t }
	' "$histfile" >"${histfile}.new" && mv "${histfile}.new" "$histfile"
}

