#!/bin/sh

# _nime - browse and watch anime from the terminal
# Scrapes animesuge.cz and anichan.to, resolves the stream and plays it locally.
#
# Everything is one POSIX shell script: requests with curl, payload decryption
# with openssl, parsing with sed, grep and awk, playback through whatever local
# player is installed.
#
# This program is free software: you can redistribute it and/or modify it under
# the terms of the GNU General Public License as published by the Free Software
# Foundation, either version 3 of the License, or (at your option) any later
# version.

version="1.9.23"

# ---- set this after you fork/upload the repo, it powers `_nime -U` ----------
repo_user="${_NIME_USER:-optimalguyy}"
repo_branch="${_NIME_BRANCH:-master}"
update_base="https://raw.githubusercontent.com/${repo_user}/_nime/${repo_branch}"
api_base="https://api.github.com/repos/${repo_user}/_nime/contents"

TAB=$(printf '\t')
req_deps="curl sed grep awk openssl"
opt_deps="fzf mpv vlc yt-dlp ffmpeg syncplay python3"

# ---------------------------------------------------------------------------
# output helpers
# ---------------------------------------------------------------------------

# how many status lines are on the screen, so they can be taken back off it
status_lines=0

# erase the status lines printed so far, leaving the terminal as it was
clear_status() {
	[ "${status_lines:-0}" -gt 0 ] 2>/dev/null || return 0
	printf '\33[%dA\33[0J' "$status_lines" >&2
	status_lines=0
}

# what the audio of the run will be, said on every episode so which track is
# being asked for is never a guess
mode_word() {
	if [ "$mode" = dub ]; then
		printf 'English dub'
	else
		printf 'original audio'
	fi
}

# an episode that cannot be found while asking for the dub is a missing dub, and
# saying so is more use than "no sources"
dub_die() {
	if [ "$mode" = dub ]; then
		die "$1: no English dub for it (the dub may not be out yet; --sub plays the original audio)"
	fi
	die "$1!"
}

die() {
	printf '\33[2K\r' >&2
	clear_status
	printf '\33[1;31m%s\033[0m\n' "$*" >&2
	exit 1
}

info() {
	status_lines=$((status_lines + 1))
	printf '\33[2K\r\033[1;34m%s\033[0m\n' "$*" >&2
}

warn() {
	status_lines=$((status_lines + 1))
	printf '\33[2K\r\033[1;33m%s\033[0m\n' "$*" >&2
}

version_info() {
	printf '_nime %s\n' "$version"
	exit 0
}

help_info() {
	cat <<-EOF
