# where downloads land: <user folder>/_nime downloads
# the folder is the first one that exists: an XDG download dir, Downloads,
# Desktop, otherwise home. _NIME_DOWNLOAD_DIR overrides all of it.
download_dir() {
	if [ -n "$_NIME_DOWNLOAD_DIR" ]; then
		printf '%s' "$_NIME_DOWNLOAD_DIR"
		return
	fi

	_base=""
	if [ "$os_id" = android ] && [ -d /storage/emulated/0 ]; then
		for _c in /storage/emulated/0/Download /storage/emulated/0/Desktop /storage/emulated/0; do
			[ -d "$_c" ] && {
				_base=$_c
				break
			}
		done
	fi

	if [ -z "$_base" ] && [ -f "${XDG_CONFIG_HOME:-$HOME/.config}/user-dirs.dirs" ]; then
		_base=$(sed -n 's|^XDG_DOWNLOAD_DIR="\(.*\)"$|\1|p' \
			"${XDG_CONFIG_HOME:-$HOME/.config}/user-dirs.dirs" | head -n 1)
		_base=$(printf '%s' "$_base" | sed "s|^\$HOME|$HOME|")
		[ -d "$_base" ] || _base=""
	fi

	if [ -z "$_base" ]; then
		for _c in "$HOME/Downloads" "$HOME/Desktop" "$HOME/desktop" "$HOME"; do
			[ -d "$_c" ] && {
				_base=$_c
				break
			}
		done
	fi

	[ -z "$_base" ] && _base=$(pwd)
	printf '%s/_nime downloads' "$_base"
}

# downloads are written as mp4 with the subtitles muxed in as a soft
# (selectable) track, which mpv, vlc, quicktime and every normal player lists
# in its subtitle menu.
download_video() {
	_dl_dir=$(download_dir)
	if ! mkdir -p "$_dl_dir" 2>/dev/null; then
		warn "Could not create $_dl_dir, using the current directory"
		_dl_dir=$(pwd)
	fi

	_name=$(printf '%s' "$anime_title" | sed 's|[/\\:*?"<>|]|_|g; s|  *| |g; s| *$||')_E${ep_no}
	_tmpd=$(mktemp -d 2>/dev/null)
	[ -d "$_tmpd" ] || {
		_tmpd="$_dl_dir/.nime-tmp-$$"
		mkdir -p "$_tmpd"
	}
	_final="$_dl_dir/$_name.mp4"

	info "Downloading $anime_title episode $ep_no..."
	_ok=0
	if command -v yt-dlp >/dev/null 2>&1; then
		yt-dlp --no-progress --referer "$refr" -f 'bv*+ba/b' --merge-output-format mp4 \
			-o "$_tmpd/raw.%(ext)s" "$video_link" >/dev/null 2>&1 && _ok=1
	elif command -v ffmpeg >/dev/null 2>&1; then
		ffmpeg -loglevel error -referer "$refr" -i "$video_link" \
			-c copy -bsf:a aac_adtstoasc "$_tmpd/raw.mp4" && _ok=1
	else
		warn "Neither yt-dlp nor ffmpeg found, cannot download"
		rm -rf "$_tmpd"
		return 1
	fi

	if [ "$_ok" != 1 ]; then
		warn "Download failed"
		rm -rf "$_tmpd"
		return 1
	fi

	_raw=$(ls "$_tmpd"/raw.* 2>/dev/null | head -n 1)
	[ -z "$_raw" ] && {
		warn "Download produced no file"
		rm -rf "$_tmpd"
		return 1
	}

	# which tracks to embed: everything with --sub-lang all, otherwise the pick
	_sel_tracks=""
	if [ -n "$sub_tracks" ]; then
		case "$sub_lang" in
			all | ALL | All) _sel_tracks=$sub_tracks ;;
			*)
				if [ -n "$sub_link" ]; then
					_sel_tracks=$(printf '%s\n' "$sub_tracks" | awk -F'\t' -v u="$sub_link" '$4 == u { print; exit }')
					[ -z "$_sel_tracks" ] && _sel_tracks=$(printf '%s\n' "$sub_tracks" |
						awk -F'\t' -v c="$sub_code" '$1 == c { print; exit }')
				fi
				;;
		esac
	fi

	mkdir -p "$_tmpd/subs"
	_k=0
	if [ -n "$_sel_tracks" ]; then
		printf '%s\n' "$_sel_tracks" >"$_tmpd/tracks.tsv"
		_k=0
		while IFS=$TAB read -r _code _label _def _url; do
			[ -z "$_url" ] && continue
			_n=$(printf '%02d' $((_k + 1)))
			curl -sSL -A "$agent" -e "$refr" --max-time 60 \
				-o "$_tmpd/subs/sub-$_n.vtt" "$_url" 2>/dev/null
			if [ -s "$_tmpd/subs/sub-$_n.vtt" ]; then
				_k=$((_k + 1))
				printf '%s\t%s\n' "$_n" "$_code" >>"$_tmpd/subs/index.tsv"
			else
				rm -f "$_tmpd/subs/sub-$_n.vtt"
			fi
		done <"$_tmpd/tracks.tsv"
	fi

	_subs=0
	if [ "$_k" -gt 0 ] && command -v ffmpeg >/dev/null 2>&1; then
		_inputs=""
		_maps="-map 0:v:0 -map 0:a?"
		_meta=""
		_disp=""
		_j=0
		while IFS=$TAB read -r _n _code; do
			_inputs="$_inputs -i $_tmpd/subs/sub-$_n.vtt"
			_maps="$_maps -map $((_j + 1)):0"
			_meta="$_meta -metadata:s:s:$_j language=$_code"
			[ "$_code" = "$sub_code" ] && _disp="-disposition:s:s:$_j default"
			_j=$((_j + 1))
		done <"$_tmpd/subs/index.tsv"
		[ -z "$_disp" ] && _disp="-disposition:s:s:0 default"

		info "Muxing $_j subtitle track(s) into the video..."
		# word splitting is wanted here: the flags are built up above
		if ffmpeg -loglevel error -y -i "$_raw" $_inputs $_maps \
			-c copy -c:s mov_text $_meta $_disp "$_final"; then
			_subs=1
		else
			warn "Could not mux the subtitles, saving them next to the video instead"
		fi
	fi

	if [ "$_subs" = 1 ]; then
		rm -rf "$_tmpd"
		info "Saved $_final ($_j subtitle track(s), switch them in your player)"
		return 0
	fi

	if [ -d "$_tmpd/subs" ]; then
		while IFS=$TAB read -r _n _code; do
			cp "$_tmpd/subs/sub-$_n.vtt" "$_dl_dir/$_name.$_code.vtt" 2>/dev/null
		done <"$_tmpd/subs/index.tsv"
	fi
	mv "$_raw" "$_final" 2>/dev/null || cp "$_raw" "$_final"
	_rc=$?
	rm -rf "$_tmpd"
	[ "$_rc" = 0 ] && info "Saved $_final"
	return $_rc
}

need_am() {
	command -v am >/dev/null 2>&1 && return 0
	warn "'am' not found, Android cannot be handed the stream."
	warn "Inside Termux install it with: pkg install termux-am"
	return 1
}

# mpv-android takes no options from the intent, so they go through a file
# that the user includes in mpv.conf
android_mpv() {
	_conf_dir="/storage/emulated/0/mpv"
	if [ -w "${_conf_dir%/mpv}" ]; then
		[ -d "$_conf_dir" ] || mkdir "$_conf_dir"
		printf 'referrer=%s\n%s\n' "$refr" "${sub_link:+sub-file=$sub_link}" >"$_conf_dir/mpv.config.mp4"
	fi
	nohup am start --user 0 -a android.intent.action.VIEW -d "$video_link" \
		-n is.xyz.mpv/.MPVActivity -e "title" "$anime_title Episode $ep_no" \
		$player_extra_flags >/dev/null 2>&1 &
}

# print_mode: no player available, so hand the urls over instead of dying
print_stream() {
	printf '%s\n' "$video_link"
	[ -n "$sub_link" ] && printf 'subtitle: %s\n' "$sub_link" >&2
	printf 'referer: %s\n' "$refr" >&2
}

play_episode() {
	if [ "$player_function" = download ]; then
		download_video
		unset video_link
		return
	fi

	build_skip_flag

	case "$player_function" in
		print)
			print_stream
			unset video_link
			update_history
			return
			;;
		android_mpv)
			if need_am; then
				android_mpv
			fi
			;;
		android_vlc)
			if need_am; then
				nohup am start --user 0 -a android.intent.action.VIEW -d "$video_link" \
					-n org.videolan.vlc/org.videolan.vlc.gui.video.VideoPlayerActivity \
					-e "title" "$anime_title Episode $ep_no" $player_extra_flags >/dev/null 2>&1 &
			fi
			;;
		*flatpak*mpv*)
			nohup flatpak run io.mpv.Mpv --referrer="$refr" ${sub_link:+--sub-file="$sub_link"} \
				$skip_flag $player_extra_flags --force-media-title="$anime_title Episode $ep_no" \
				"$video_link" >/dev/null 2>&1 &
			;;
		*iina*)
			_sub_iina=$(printf '%s' "$sub_link" | sed 's|:|\\:|g')
			if pgrep -f "IINA" >/dev/null 2>&1; then
				nohup $player_function --mpv-referrer="$refr" ${_sub_iina:+--mpv-sub-files="$_sub_iina"} \
					$skip_flag $player_extra_flags --no-stdin \
					--mpv-force-media-title="$anime_title Episode $ep_no" "$video_link" >/dev/null 2>&1 &
			else
				nohup $player_function --mpv-referrer="$refr" ${_sub_iina:+--mpv-sub-files="$_sub_iina"} \
					$skip_flag $player_extra_flags --no-stdin --keep-running \
					--mpv-force-media-title="$anime_title Episode $ep_no" "$video_link" >/dev/null 2>&1 &
			fi
			;;
		*yncpla*)
			nohup $player_function $player_extra_flags "$video_link" -- $skip_flag --referrer="$refr" \
				${sub_link:+--sub-file="$sub_link"} \
				--force-media-title="$anime_title Episode $ep_no" >/dev/null 2>&1 &
			;;
		*mpv*)
			if [ "$no_detach" = 1 ]; then
				$player_function --referrer="$refr" ${sub_link:+--sub-file="$sub_link"} \
					$skip_flag $player_extra_flags --force-media-title="$anime_title Episode $ep_no" "$video_link"
			else
				nohup $player_function --referrer="$refr" ${sub_link:+--sub-file="$sub_link"} \
					$skip_flag $player_extra_flags --force-media-title="$anime_title Episode $ep_no" \
					"$video_link" >/dev/null 2>&1 &
			fi
			;;
		*vlc*)
			if [ "$no_detach" = 1 ]; then
				$player_function --http-referrer="$refr" $player_extra_flags --play-and-exit \
					--meta-title="$anime_title Episode $ep_no" "$video_link" \
					:input-slave="${sub_link:-}"
			else
				nohup $player_function --http-referrer="$refr" $player_extra_flags --play-and-exit \
					--meta-title="$anime_title Episode $ep_no" "$video_link" \
					:input-slave="${sub_link:-}" >/dev/null 2>&1 &
			fi
			;;
		iSH)
			printf '\033]8;;vlc://%s\a~~~~~~~~~~~~~~~~~~~~\n~ Tap to open VLC ~\n~~~~~~~~~~~~~~~~~~~~\033]8;;\a\n' "$video_link"
			sleep 5
			;;
		*)
			if [ "$no_detach" = 1 ]; then
				$player_function $player_extra_flags "$video_link"
			else
				nohup $player_function $player_extra_flags "$video_link" >/dev/null 2>&1 &
			fi
			;;
	esac

	replay="$video_link"
	unset video_link
	update_history
}

play() {
	_spec=$1
	[ -z "$_spec" ] && die "No episode selected"
	_range=""

	case "$_spec" in
		*" "*)
			_first=$(printf '%s' "$_spec" | awk '{print $1}')
			_last=$(printf '%s' "$_spec" | awk '{print $NF}')
			_range=$(printf '%s\n' "$ep_list" | sed -n "/^${_first}$/,/^${_last}$/p")
			;;
		*-*)
			_first=${_spec%%-*}
			_last=${_spec##*-}
			_range=$(printf '%s\n' "$ep_list" | sed -n "/^${_first}$/,/^${_last}$/p")
			;;
	esac

	if [ -n "$_range" ]; then
		for _i in $_range; do
			ep_no=$_i
			info "Playing episode $ep_no..."
			resolve_episode "$anime_id" "$ep_no" || die "No sources found for episode $ep_no"
			play_episode
		done
		return
	fi

	printf '%s\n' "$ep_list" | grep -qx "$_spec" || die "Invalid episode!"
	ep_no=$_spec
	resolve_episode "$anime_id" "$ep_no" || die "No sources found for episode $ep_no!"
	play_episode
}

# ---------------------------------------------------------------------------
# self update: pull the script back down from the git repository
# ---------------------------------------------------------------------------

update_script() {
	case "$update_base" in
		'' | *CHANGE_ME*) die "Set repo_user at the top of this script (or _NIME_USER=you) before using -U" ;;
	esac
	info "[$repo_branch] Checking for updates..."
	_latest=$(curl -sSL --fail-with-body --max-time 25 "$update_base/_nime") ||
		die "[$repo_branch] Connection error"
	_new_version=$(printf '%s' "$_latest" | sed -nE 's|^version="([^"]+)"$|\1|p' | head -n 1)
	[ -z "$_new_version" ] && die "[$repo_branch] Invalid response"

	if [ "$_new_version" = "$version" ]; then
		info "[$repo_branch] Script is up to date ($version)"
		exit 0
	fi

	_self=$(command -v _nime 2>/dev/null || printf '%s' "$0")
	cp "$_self" "${_self}.bak" 2>/dev/null
	if printf '%s' "$_latest" >"${_self}.new" && chmod +x "${_self}.new" && mv "${_self}.new" "$_self"; then
		info "[$repo_branch] Updated: $version -> $_new_version (old copy in ${_self}.bak)"
	else
		rm -f "${_self}.new"
		die "Could not write $_self, try again with sudo"
	fi
	exit 0
}

# ---------------------------------------------------------------------------
# main
# ---------------------------------------------------------------------------

provider="${_NIME_SOURCE:-animesuge}"
mode="${_NIME_MODE:-sub}"
quality="${_NIME_QUALITY:-best}"
menu_program="${_NIME_MENU:-fzf}"
menu_extra_flags="${_NIME_MENU_FLAGS:-}"
player_extra_flags="${_NIME_PLAYER_FLAGS:-}"
no_detach="${_NIME_NO_DETACH:-0}"
skip_intro="${_NIME_SKIP:-0}"
sub_lang="${_NIME_SUB_LANG:-}"
sub_tracks=""
sub_code=""
sub_label=""
list_subs=0
index=""
ep_no=""
query=""
source="search"
player_function=""
replay=""
skip_flag=""
do_check_deps=0

while [ $# -gt 0 ]; do
	case "$1" in
		-s | --source)
			[ $# -lt 2 ] && die "missing argument!"
			provider=$2
			shift
			;;
		-c | --continue) source=history ;;
		-d | --download) player_function=download ;;
		-D | --delete)
			: >"$histfile"
			info "History deleted"
			exit 0
			;;
		-q | --quality)
			[ $# -lt 2 ] && die "missing argument!"
			quality=$2
			shift
			;;
		-e | --episode | -r | --range)
			[ $# -lt 2 ] && die "missing argument!"
			ep_no=$2
			shift
			;;
		-S | --select-nth)
			[ $# -lt 2 ] && die "missing argument!"
			index=$2
			shift
			;;
		-v | --vlc) player_function=vlc ;;
		--skip) skip_intro=1 ;;
		--sub-lang)
			[ $# -lt 2 ] && die "missing argument!"
			sub_lang=$2
			shift
			;;
		--list-subs) list_subs=1 ;;
		--no-detach) no_detach=1 ;;
		--check-deps) do_check_deps=1 ;;
		-V | --version) version_info ;;
		-h | --help) help_info ;;
		-U | --update)
			branch=$repo_branch
			update_script
			;;
		--syncplay)
			case "$os_id" in
				macos) player_function="/Applications/Syncplay.app/Contents/MacOS/syncplay" ;;
				windows)
					PATH="$PATH:/c/Program Files (x86)/Syncplay/"
					player_function="syncplay.exe"
					;;
				*) player_function="syncplay" ;;
			esac
			;;
		*) query="$query $1" ;;
	esac
	shift
done

query=$(printf '%s' "$query" | sed 's|^ *||;s| *$||')

case "$provider" in
	animesuge | anichan) ;;
	*) die "Unknown source '$provider' (use animesuge or anichan)" ;;
esac

case "$menu_program" in
	fzf) dep_ch_failover "fzf" >/dev/null 2>&1 || menu_program=none ;;
esac

# ---- player resolution, per platform ----
if [ -z "$player_function" ]; then
	case "$os_id" in
		android) player_function="${_NIME_PLAYER:-android_mpv}" ;;
		ish) player_function="${_NIME_PLAYER:-iSH}" ;;
		windows) player_function="${_NIME_PLAYER:-$(dep_ch_failover "mpv.exe,vlc.exe")}" ;;
		macos)
			player_function="${_NIME_PLAYER:-$(dep_ch_failover "iina,/Applications/IINA.app/Contents/MacOS/iina-cli,mpv,vlc")}"
			;;
		*)
			player_function="${_NIME_PLAYER:-$(dep_ch_failover "mpv,$HOME/.local/share/flatpak/app/io.mpv.Mpv/,/var/lib/flatpak/app/io.mpv.Mpv/,vlc")}"
			;;
	esac
fi

case "$player_function" in
	vlc)
		case "$os_id" in
			android) player_function=android_vlc ;;
			windows) player_function=vlc.exe ;;
			ish) player_function=iSH ;;
			*) player_function=vlc ;;
		esac
		;;
esac

# no player at all: stay useful by printing the resolved stream
if [ -z "$player_function" ]; then
	[ "$do_check_deps" = 1 ] || warn "No player found (mpv or vlc). The stream url will be printed."
	player_function=print
fi

if [ "$do_check_deps" = 1 ]; then
	check_deps
	exit 0
fi

case "$player_function" in
	print | android_mpv | android_vlc | iSH) ;;
	download) dep_ch_failover "yt-dlp,ffmpeg" >/dev/null || die "Neither yt-dlp nor ffmpeg found" ;;
	*flatpak*mpv*) dep_ch flatpak ;;
	*yncpla*)
		if [ -x "$player_function" ]; then :; else
			command -v syncplay >/dev/null 2>&1 || die "Syncplay not found"
		fi
		;;
	*) dep_ch "$player_function" ;;
esac

trap 'tput sgr0 2>/dev/null; rm -f "${histfile}.new"' INT HUP TERM

info "_nime $version"

# ---------------------------------------------------------------------------
# pick an anime
# ---------------------------------------------------------------------------

if [ "$source" = history ]; then
	[ -s "$histfile" ] || die "No history yet, watch something first"
	_entries=$(awk -F'\t' 'NF>=4 { printf "%s\t%s (%s) - episode %s\n", $3, $4, $2, $1 }' "$histfile")

	if [ -n "$index" ]; then
		_sel=$(printf '%s\n' "$_entries" | sed -n "${index}p")
	else
		_sel=$(printf '%s\n' "$_entries" | nth "Select anime")
	fi
	[ -z "$_sel" ] && die "Invalid selection"

	_sel_title=$(printf '%s' "$_sel" | cut -f 2)
	provider=$(printf '%s' "$_sel_title" | sed -nE 's#.*\((animesuge|anichan)\).*#\1#p')
	anime_id=$(printf '%s' "$_sel" | cut -f 1)
	anime_title=$(printf '%s' "$_sel_title" | sed -E 's# \((animesuge|anichan)\).*##')
	ep_no=$(printf '%s' "$_sel_title" | sed -nE 's|.* - episode ([^ ]*)$|\1|p')
	[ -z "$provider" ] && die "History entry is broken, delete it with -D"

	episode_maps=$(provider_episode_maps "$anime_id")
	ep_list=$(printf '%s\n' "$episode_maps" | cut -f 1)
	[ -z "$ep_list" ] && die "Could not load episodes for that entry"
else
	[ -z "$query" ] && die "No query given (try _nime -h)"
	info "Searching $provider for '$query'..."
	_enc_query=$(printf '%s' "$query" | sed 's| |+|g')
	results=$(provider_search "$_enc_query")
	[ -z "$results" ] && die "No results found for '$query'"

	if [ -n "$index" ]; then
		_sel=$(printf '%s\n' "$results" | sed -n "${index}p")
	else
		_sel=$(printf '%s\n' "$results" | nth "Select anime")
	fi
	[ -z "$_sel" ] && die "Invalid anime selection"

	anime_id=$(printf '%s' "$_sel" | cut -f 1)
	anime_title=$(printf '%s' "$_sel" | cut -f 2)

	if [ "$provider" = animesuge ]; then
		_resolved=$(as_anime_id "$anime_id") || die "Could not open that anime"
		[ -z "$_resolved" ] && die "Could not read the anime id"
		anime_id=$_resolved
	fi

	episode_maps=$(provider_episode_maps "$anime_id") || die "Could not load the episode list"
	ep_list=$(printf '%s\n' "$episode_maps" | cut -f 1)
	[ -z "$ep_list" ] && die "No episodes found"
fi

if [ -z "$ep_no" ]; then
	ep_no=$(printf '%s\n' "$episode_maps" | awk -F'\t' '{ printf "%s\tepisode %s\n", $1, $1 }' | nth "Select episode")
	[ -z "$ep_no" ] && die "Invalid episode selection"
fi

play "$ep_no"

# ---------------------------------------------------------------------------
# after playback
# ---------------------------------------------------------------------------

while [ "$player_function" != download ] && [ "$player_function" != print ]; do
	_cmd=$(printf 'next\tnext\nreplay\treplay\nprevious\tprevious\nselect\tselect\nquit\tquit\n' |
		nth "Playing episode $ep_no of $anime_title")
	case "$_cmd" in
		next) ep_no=$(printf '%s\n' "$ep_list" | sed -n "/^${ep_no}$/{n;p;}") ;;
		previous) ep_no=$(printf '%s\n' "$ep_list" | sed -n "/^${ep_no}$/{g;1!p;};h") ;;
		replay)
			video_link="$replay"
			refr="https://megaplay.buzz/"
			play_episode
			continue
			;;
		select) ep_no=$(printf '%s\n' "$episode_maps" | awk -F'\t' '{ printf "%s\tepisode %s\n", $1, $1 }' | nth "Select episode") ;;
		*) break ;;
	esac
	[ -z "$ep_no" ] && {
		warn "Out of range"
		break
	}
	play "$ep_no"
done

rm -f "${histfile}.new"

